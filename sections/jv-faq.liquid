{% comment %} JV - FAQ {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --cream: #FCFAEF;
    --cream-alt: #FAF7EF;
    --cream-warm: #FAE9C9;
    --dark: #232323;
    --text: #2D2B27;
    --btn-green: #36402D;
    --gold: #B78C47;
    --gold-bright: #F5B857;
    --gold-cta: #D6A24C;
    --gold-light: #EBDEc5;
    --green-check: #35911E;
    --white: #FFFFFF;
    --border: rgba(45,43,39,0.13);
    --font-heading: 'Petrona', serif;
    --font-body: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .faq-section {
    background: var(--cream-alt);
    padding: 64px 48px;
  }

  #shopify-section-{{ section.id }} .faq-inner {
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .gold-rule {
    width: 48px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .faq-inner h2 {
    font-family: 'Petrona', serif;
    font-size: 46px;
    font-weight: 500;
    color: var(--dark);
    margin-bottom: 36px;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .faq-list {
    display: grid;
    grid-template-columns: repeat(2, 641px);
    gap: 14px;
    justify-content: center;
    margin-bottom: 40px;
    width: 100%;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .faq-item {
    border: 1px solid var(--border);
    background: var(--cream-alt);
  }

  #shopify-section-{{ section.id }} .faq-item details summary {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text);
    padding: 0 20px;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    cursor: pointer;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .faq-item details summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .faq-item .acc-body {
    font-family: var(--font-body);
    font-size: 14px;
    padding: 0 20px 16px;
    line-height: 1.65;
    color: rgba(45,43,39,0.65);
  }

  #shopify-section-{{ section.id }} .faq-item .acc-body p {
    margin: 0 0 8px;
  }

  #shopify-section-{{ section.id }} .faq-item .acc-body p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .acc-toggle {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border: 1px solid rgba(45,43,39,0.25);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: rgba(45,43,39,0.5);
  }

  #shopify-section-{{ section.id }} .acc-toggle::after {
    content: '+';
    line-height: 1;
    display: block;
  }

  #shopify-section-{{ section.id }} details[open] .acc-toggle::after {
    content: '−';
  }

  #shopify-section-{{ section.id }} .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .btn-cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--btn-green);
    color: #fff;
    border: none;
    width: 553px;
    max-width: 100%;
    height: 78px;
    padding: 0 24px;
    font-family: 'Dosis', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .btn-cart:hover {
    opacity: 0.92;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq-section {
      padding: 40px 16px;
    }

    #shopify-section-{{ section.id }} .faq-inner h2 {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .faq-list {
      grid-template-columns: 1fr;
      gap: 8px;
      margin-left: -16px;
      margin-right: -16px;
    }

    #shopify-section-{{ section.id }} .faq-item details summary {
      padding: 16px;
      min-height: auto;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .faq-item .acc-body {
      padding: 0 16px 14px;
    }
  }
</style>

<section class="faq-section">
  <div class="faq-inner">

    <div class="gold-rule"></div>
    <h2>{{ section.settings.heading }}</h2>

    {%- if section.blocks.size > 0 -%}
      <div class="faq-list">
        {%- for block in section.blocks -%}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <details>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span class="acc-toggle" aria-hidden="true"></span>
              </summary>
              <div class="acc-body">
                {{ block.settings.answer }}
              </div>
            </details>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cta-block">
      <a href="{{ section.settings.cta_url }}" class="btn-cart">{{ section.settings.cta_text }}</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "JV - FAQ",
  "tag": "section",
  "class": "jv-section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "JV - FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "IS THERE A CUTOFF TIME FOR SAME-DAY SHIPPING?",
            "answer": "<p>Orders placed before 2:00 PM CST Monday–Friday ship the same day. Orders after that cutoff or placed on weekends ship the next business day.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "WHAT IF I'M NOT GIFTING — CAN I STILL ADD A PERSONAL NOTE?",
            "answer": "<p>Absolutely. You can add a personal message at checkout whether you're sending it as a gift or treating yourself. We'll include it on a handwritten card inside the box.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "HOW LONG DO YOUR CANDLES BURN?",
            "answer": "<p>Our standard candles burn for 55–65 hours depending on the size and scent. Trim the wick to 1/4 inch before each burn for the longest, cleanest burn.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "ARE YOUR CANDLES SAFE FOR PETS AND CHILDREN?",
            "answer": "<p>Yes. We use 100% natural soy wax and phthalate-free fragrance oils. As with any open flame, never leave a burning candle unattended around pets or small children.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "DO YOU OFFER RETURNS OR EXCHANGES?",
            "answer": "<p>We stand behind every candle we make. If you're not completely satisfied, contact us within 30 days of delivery and we'll make it right — exchange, store credit, or full refund.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "WHERE ARE YOUR CANDLES MADE?",
            "answer": "<p>Every Jackson Vaughn candle is hand-poured in Texas by our small team of artisans. We've been crafting candles this way since 2000 — no shortcuts, no outsourcing.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}