{% comment %} JV - Press {% endcomment %}
{%- liquid
  # Content source: product metafield metaobject -> section settings (fallback).
  # Metafield: product.metafields.custom.product_press_section
  # Section padding is NOT in the metaobject, so it always uses section settings.
  assign mo = product.metafields.custom.product_press_section.value
  assign use_mo = false
  if mo != blank
    assign use_mo = true
  endif

  if use_mo and mo.heading != blank
    assign pr_heading = mo.heading
  else
    assign pr_heading = section.settings.heading
  endif

  if use_mo and mo.heading_size_desktop != blank
    assign pr_heading_size = mo.heading_size_desktop
  else
    assign pr_heading_size = section.settings.heading_size | default: 30
  endif

  if use_mo and mo.heading_size_mobile != blank
    assign pr_heading_size_mobile = mo.heading_size_mobile
  else
    assign pr_heading_size_mobile = section.settings.heading_size_mobile | default: 26
  endif

  if use_mo and mo.heading_letter_spacing != blank
    assign pr_heading_spacing = mo.heading_letter_spacing
  else
    assign pr_heading_spacing = section.settings.heading_spacing | default: 4
  endif

  if use_mo and mo.space_below_heading != blank
    assign pr_heading_gap = mo.space_below_heading
  else
    assign pr_heading_gap = section.settings.heading_gap | default: 48
  endif

  if use_mo and mo.items_per_view_desktop != blank
    assign spv_desktop = mo.items_per_view_desktop
  else
    assign spv_desktop = section.settings.per_view_desktop | default: 6
  endif

  if use_mo and mo.items_per_view_tablet != blank
    assign spv_tablet = mo.items_per_view_tablet
  else
    assign spv_tablet = section.settings.per_view_tablet | default: 3
  endif

  if use_mo and mo.items_per_view_mobile != blank
    assign spv_mobile = mo.items_per_view_mobile
  else
    assign spv_mobile = section.settings.per_view_mobile | default: 1.3
  endif

  if use_mo and mo.edge_peek_desktop_tablet != blank
    assign peek = mo.edge_peek_desktop_tablet
  else
    assign peek = section.settings.edge_peek | default: 80
  endif

  if use_mo and mo.gap_between_items != blank
    assign space = mo.gap_between_items
  else
    assign space = section.settings.item_gap | default: 24
  endif

  if use_mo and mo.loop_infinite != blank
    assign pr_loop = mo.loop_infinite
  else
    assign pr_loop = section.settings.enable_loop
  endif

  if use_mo and mo.show_arrows_desktop != blank
    assign pr_arrows = mo.show_arrows_desktop
  else
    assign pr_arrows = section.settings.show_arrows
  endif

  if use_mo and mo.show_dots != blank
    assign pr_dots = mo.show_dots
  else
    assign pr_dots = section.settings.show_dots
  endif

  if use_mo and mo.autoplay != blank
    assign pr_autoplay = mo.autoplay
  else
    assign pr_autoplay = section.settings.autoplay
  endif

  if use_mo and mo.autoplay_speed != blank
    assign pr_autoplay_speed = mo.autoplay_speed
  else
    assign pr_autoplay_speed = section.settings.autoplay_speed | default: 4
  endif

  if use_mo and mo.logo_area_height != blank
    assign pr_logo_height = mo.logo_area_height
  else
    assign pr_logo_height = section.settings.logo_height | default: 90
  endif

  if use_mo and mo.space_below_logo != blank
    assign pr_logo_gap = mo.space_below_logo
  else
    assign pr_logo_gap = section.settings.logo_gap | default: 28
  endif

  if use_mo and mo.description_size != blank
    assign pr_text_size = mo.description_size
  else
    assign pr_text_size = section.settings.text_size | default: 16
  endif

  if use_mo and mo.text_alignment != blank
    assign pr_text_align = mo.text_alignment
  else
    assign pr_text_align = section.settings.text_align | default: 'left'
  endif

  if use_mo and mo.background != blank
    assign pr_bg = mo.background
  else
    assign pr_bg = section.settings.background_color | default: '#FBF3EC'
  endif

  if use_mo and mo.heading_arrow_color != blank
    assign pr_heading_color = mo.heading_arrow_color
  else
    assign pr_heading_color = section.settings.heading_color | default: '#2C2622'
  endif

  if use_mo and mo.description_color != blank
    assign pr_text_color = mo.description_color
  else
    assign pr_text_color = section.settings.text_color | default: '#3C3630'
  endif

  if use_mo and mo.border_top_width != blank
    assign pr_border_top_width = mo.border_top_width
  else
    assign pr_border_top_width = section.settings.border_top_width
  endif

  if use_mo and mo.border_top_color != blank
    assign pr_border_top_color = mo.border_top_color
  else
    assign pr_border_top_color = section.settings.border_top_color | default: '#2C2622'
  endif

  if use_mo and mo.border_bottom_width != blank
    assign pr_border_bottom_width = mo.border_bottom_width
  else
    assign pr_border_bottom_width = section.settings.border_bottom_width
  endif

  if use_mo and mo.border_bottom_color != blank
    assign pr_border_bottom_color = mo.border_bottom_color
  else
    assign pr_border_bottom_color = section.settings.border_bottom_color | default: '#2C2622'
  endif

  # Press items list: metaobject press_items else section blocks.
  assign pr_items = mo.press_items.value
  assign use_mo_items = false
  if use_mo and pr_items != blank and pr_items.size > 0
    assign use_mo_items = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pr-bg: {{ pr_bg }};
    --pr-heading: {{ pr_heading_color }};
    --pr-text: {{ pr_text_color }};
    --pr-peek: {{ peek }}px;
    --pr-space: {{ space }}px;
  }

  #shopify-section-{{ section.id }} .jv-press {
    background: var(--pr-bg);
    font-family: var(--font-body-family);
    padding: {{ section.settings.padding_top | default: 72 }}px 0
      {{ section.settings.padding_bottom | default: 72 }}px;
    width: 100%;
    overflow: hidden;
    {%- if pr_border_top_width > 0 -%}
      border-top: {{ pr_border_top_width }}px solid {{ pr_border_top_color }};
    {%- endif -%}
    {%- if pr_border_bottom_width > 0 -%}
      border-bottom: {{ pr_border_bottom_width }}px solid {{ pr_border_bottom_color }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .jv-press-heading {
    font-family: var(--font-heading);
    font-weight: normal;
    font-size: {{ pr_heading_size }}px;
    line-height: 1.2;
    letter-spacing: {{ pr_heading_spacing }}px;
    text-transform: uppercase;
    text-align: center;
    color: var(--pr-heading);
    margin: 0 0 {{ pr_heading_gap }}px;
    padding: 0 24px;
  }

  /* ── Slider ── */
  #shopify-section-{{ section.id }} .jv-press-slider {
    position: relative;
  }

  /* Peek gutters (desktop/tablet). Swiper subtracts horizontal padding from the
     size it divides by slidesPerView, so the slides fill the middle exactly and
     the gutters show the neighbouring items — overflow clips at the padding box,
     which keeps them visible. */
  #shopify-section-{{ section.id }} .jv-press-swiper {
    overflow: hidden;
    padding: 0 var(--pr-peek);
  }

  /* Fallback sizing before Swiper initialises (avoids a flash of full-width slides) */
  #shopify-section-{{ section.id }} .jv-press-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: var(--pr-space);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .jv-press-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - ({{ spv_desktop | minus: 1 }} * var(--pr-space))) / {{ spv_desktop }});
  }

  #shopify-section-{{ section.id }} .jv-press-slide {
    height: auto;
  }

  #shopify-section-{{ section.id }} .jv-press-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    text-align: {{ pr_text_align }};
    color: inherit;
    text-decoration: none;
  }

  /* ── Logo ── */
  #shopify-section-{{ section.id }} .jv-press-logo {
    width: 100%;
    height: {{ pr_logo_height }}px;
    display: flex;
    align-items: center;
    margin-bottom: {{ pr_logo_gap }}px;
  }
  #shopify-section-{{ section.id }} .jv-press-logo img {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: {{ pr_text_align }};
    display: block;
  }
  #shopify-section-{{ section.id }} .jv-press-logo .placeholder-svg {
    max-width: 60%;
    max-height: 100%;
    opacity: 0.25;
  }

  /* ── Description ── */
  #shopify-section-{{ section.id }} .jv-press-desc {
    width: 100%;
    font-size: {{ pr_text_size }}px;
    line-height: 1.6;
    color: var(--pr-text);
  }
  #shopify-section-{{ section.id }} .jv-press-desc p {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .jv-press-desc a {
    color: inherit;
    text-decoration: underline;
  }

  /* ── Arrows (outside the clipped swiper) ── */
  #shopify-section-{{ section.id }} .jv-press-arrow {
    position: absolute;
    top: {{ pr_logo_height }}px;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--pr-bg);
    color: var(--pr-heading);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-press-arrow:hover {
    background: var(--pr-heading);
    color: var(--pr-bg);
  }
  #shopify-section-{{ section.id }} .jv-press-arrow svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  #shopify-section-{{ section.id }} .jv-press-arrow--prev {
    left: 24px;
  }
  #shopify-section-{{ section.id }} .jv-press-arrow--next {
    right: 24px;
  }
  #shopify-section-{{ section.id }} .jv-press-arrow.swiper-button-disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Pagination ── */
  #shopify-section-{{ section.id }} .jv-press-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .jv-press-pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pr-heading);
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-press-pagination .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* ── Tablet ── */
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .jv-press-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc((100% - ({{ spv_tablet | minus: 1 }} * var(--pr-space))) / {{ spv_tablet }});
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .jv-press {
      padding: {{ section.settings.padding_top_mobile | default: 48 }}px 0
        {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }
    #shopify-section-{{ section.id }} .jv-press-heading {
      font-size: {{ pr_heading_size_mobile }}px;
      margin-bottom: 32px;
      padding: 0 16px;
    }
    #shopify-section-{{ section.id }} .jv-press-swiper {
      padding: 0 0 0 16px;
    }
    #shopify-section-{{ section.id }} .jv-press-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(100% / {{ spv_mobile }});
    }
    #shopify-section-{{ section.id }} .jv-press-arrow {
      display: none;
    }
  }
</style>

<div class="jv-press {% unless use_mo %}{% if section.blocks.size < 1 %}hidden{% endif %}{% endunless %}">
  {%- if pr_heading != blank -%}
    <h2 class="jv-press-heading">{{ pr_heading }}</h2>
  {%- endif -%}

  {%- if use_mo_items or section.blocks.size > 0 -%}
    <div class="jv-press-slider" data-loader-script="{{ 'halo.jv-press.js' | asset_url }}">
      <div
        class="swiper jv-press-swiper"
        data-jv-press
        data-per-desktop="{{ spv_desktop }}"
        data-per-tablet="{{ spv_tablet }}"
        data-per-mobile="{{ spv_mobile }}"
        data-space="{{ space }}"
        data-loop="{{ pr_loop }}"
        data-arrows="{{ pr_arrows }}"
        data-dots="{{ pr_dots }}"
        data-autoplay="{{ pr_autoplay }}"
        data-autoplay-speed="{{ pr_autoplay_speed | times: 1000 }}"
      >
        <div class="swiper-wrapper">
          {%- if use_mo_items -%}
            {%- for item in pr_items -%}
              {%- assign is_link = false -%}
              {%- if item.link_optional != blank -%}{%- assign is_link = true -%}{%- endif -%}

              <div class="swiper-slide jv-press-slide">
                {%- if is_link -%}
                  <a href="{{ item.link_optional }}" class="jv-press-item">
                {%- else -%}
                  <div class="jv-press-item">
                {%- endif -%}
                  <div class="jv-press-logo">
                    {%- if item.logo_image != blank -%}
                      {{
                        item.logo_image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(max-width: 768px) 70vw, 16vw',
                          widths: '200, 300, 450, 600',
                          alt: item.logo_image.alt
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  {%- if item.description != blank -%}
                    <div class="jv-press-desc rte">{{ item.description | metafield_tag }}</div>
                  {%- endif -%}
                {%- if is_link -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- assign is_link = false -%}
              {%- if block.settings.link != blank -%}{%- assign is_link = true -%}{%- endif -%}

              <div class="swiper-slide jv-press-slide" {{ block.shopify_attributes }}>
                {%- if is_link -%}
                  <a href="{{ block.settings.link }}" class="jv-press-item">
                {%- else -%}
                  <div class="jv-press-item">
                {%- endif -%}
                  <div class="jv-press-logo">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(max-width: 768px) 70vw, 16vw',
                          widths: '200, 300, 450, 600',
                          alt: block.settings.image.alt
                      }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  {%- if block.settings.description != blank -%}
                    <div class="jv-press-desc rte">{{ block.settings.description }}</div>
                  {%- endif -%}
                {%- if is_link -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- if pr_arrows -%}
        <button class="jv-press-arrow jv-press-arrow--prev" type="button" aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="jv-press-arrow jv-press-arrow--next" type="button" aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if pr_dots -%}
        <div class="jv-press-pagination"></div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'halo.jv-press.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "JV - Press",
  "tag": "section",
  "class": "jv-section-press",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen In"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "per_view_desktop",
      "label": "Items per view (desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "per_view_tablet",
      "label": "Items per view (tablet)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "per_view_mobile",
      "label": "Items per view (mobile)",
      "min": 1,
      "max": 2.5,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "range",
      "id": "edge_peek",
      "label": "Edge peek (desktop/tablet)",
      "info": "How much of the first & last items is clipped at the edges.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Loop (infinite)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Item style"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo area height",
      "min": 30,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Space below logo",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF3EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / arrow color",
      "default": "#2C2622"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#3C3630"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_top_width",
      "label": "Border top width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Border top color",
      "default": "#2C2622"
    },
    {
      "type": "range",
      "id": "border_bottom_width",
      "label": "Border bottom width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_bottom_color",
      "label": "Border bottom color",
      "default": "#2C2622"
    }
  ],
  "blocks": [
    {
      "type": "press_item",
      "name": "Press item",
      "settings": [
        {
