<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --cream: #FCFAEF;
    --dark: #232323;
    --btn-green: #36402D;
    --gold: #B78C47;
    --gold-cta: #D6A24C;
    --gold-dk: #B07A2E;
    --green: #36402D;
    --text: #2d2b27;
    --border: rgba(45,43,39,0.13);
    --font-h: 'Petrona', Georgia, serif;
    --font-b: 'Dosis', system-ui, sans-serif;
    --max-width: 1408px;
  }

  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .lifestyle {
    background: var(--cream);
    padding: 0 16px 0;
  }

  #shopify-section-{{ section.id }} .lifestyle__box {
    max-width: var(--max-width);
    margin: 0 auto;
    border: 1px solid #d8d5ce;
    border-top: none;
    padding: 32px 32px 32px;
  }

  #shopify-section-{{ section.id }} .features__eyebrow {
    width: 40px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .lifestyle__heading {
    font-family: var(--font-h);
    font-size: 40px;
    font-weight: 500;
    color: var(--text);
    line-height: 1.15;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .lifestyle__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .lifestyle__item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 310/477;
    cursor: pointer;
    display: block;
  }

  #shopify-section-{{ section.id }} .lifestyle__item__bg {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .lifestyle__item__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .lifestyle__item__bg .img-placeholder {
    width: 100%;
    height: 100%;
    background: #d8d5ce;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-b);
    font-size: 11px;
    color: #888;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .lifestyle__item__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .lifestyle__play {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255,255,255,0.82);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .lifestyle__play svg {
    margin-left: 3px;
  }

  /* Dots â€” mobile scroll indicator */
  #shopify-section-{{ section.id }} .ls-dots {
    display: none;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .ls-dot {
    display: block;
    height: 2px;
    width: 30px;
    background: var(--gold);
    opacity: 0.25;
    border-radius: 1px;
    transition: width 0.2s, opacity 0.2s;
  }

  #shopify-section-{{ section.id }} .ls-dot.active {
    width: 48px;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .lifestyle__cta {
    max-width: 420px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .btn-atc {
    display: block;
    width: 100%;
    background: var(--green);
    color: #fff;
    font-family: var(--font-b);
    font-size: 19px;
    font-weight: 500;
    padding: 18px 24px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .lifestyle__shield-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-b);
    font-size: 13px;
    color: #555;
    margin-top: 12px;
    font-weight: 500;
  }

  /* Mobile */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .lifestyle__box {
      padding: 20px 16px 24px;
    }

    #shopify-section-{{ section.id }} .lifestyle__heading {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .lifestyle__grid {
      display: flex;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 10px;
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .lifestyle__grid::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .lifestyle__item {
      display: block !important;
      flex: none;
      width: 185px;
      height: 303px;
      aspect-ratio: unset;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .ls-dots {
      display: flex;
    }

    #shopify-section-{{ section.id }} .lifestyle__cta {
      max-width: 100%;
    }
  }

  /* Desktop larger */
  @media (min-width: 1280px) {
    #shopify-section-{{ section.id }} .lifestyle__cta {
      max-width: 555px;
    }
  }
</style>

<section class="lifestyle">
  <div class="lifestyle__box">

    <div class="features__eyebrow"></div>
    <h2 class="lifestyle__heading">{{ section.settings.heading }}</h2>

    <div class="lifestyle__grid" id="ls-grid-{{ section.id }}">
      {% assign lifestyle_images = 'lifestyle_image_1,lifestyle_image_2,lifestyle_image_3,lifestyle_image_4' | split: ',' %}
      {% for img_id in lifestyle_images %}
        {% assign img = section.settings[img_id] %}
        <div class="lifestyle__item">
          <div class="lifestyle__item__bg">
            {%- if img != blank -%}
              {{ img | image_url: width: 620 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <div class="img-placeholder">Upload lifestyle_image_{{ forloop.index }}</div>
            {%- endif -%}
          </div>
          <div class="lifestyle__item__overlay">
            <div class="lifestyle__play">
              <svg width="14" height="16" viewBox="0 0 14 16" fill="none"><path d="M1 1L13 8L1 15V1Z" fill="#2d2b27"/></svg>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Mobile dots -->
    <div class="ls-dots" id="ls-dots-{{ section.id }}">
      <span class="ls-dot active"></span>
      <span class="ls-dot"></span>
      <span class="ls-dot"></span>
      <span class="ls-dot"></span>
    </div>

    <div class="lifestyle__cta">
      <a href="{{ section.settings.btn_url }}" class="btn-atc">{{ section.settings.btn_text }}</a>
      <div class="lifestyle__shield-line">
        <svg width="13" height="15" viewBox="0 0 15 17" fill="none"><path d="M7.5 0L0.5 3V8C0.5 12.1 3.6 15.9 7.5 17C11.4 15.9 14.5 12.1 14.5 8V3L7.5 0Z" fill="#2d2b27"/><path d="M4.5 8.5L6.5 10.5L10.5 6" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {{ section.settings.shield_text }}
      </div>
    </div>

  </div>
</section>

<script>
(function() {
  var grid = document.getElementById('ls-grid-{{ section.id }}');
  var dots = Array.from(document.querySelectorAll('#ls-dots-{{ section.id }} .ls-dot'));
  if (!grid || !dots.length) return;
  grid.addEventListener('scroll', function() {
    var idx = Math.min(dots.length - 1, Math.round(grid.scrollLeft / 195));
    dots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "TS - Lifestyle Gallery",
  "tag": "div",
  "class": "ts-lifestyle-gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It in Action"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image_1",
      "label": "Lifestyle Image 1"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image_2",
      "label": "Lifestyle Image 2"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image_3",
      "label": "Lifestyle Image 3"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image_4",
      "label": "Lifestyle Image 4"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "shield_text",
      "label": "Trust Line Text",
      "default": "25 Years of Hand-Poured Quality"
    }
  ],
  "presets": [
    {
      "name": "TS - Lifestyle Gallery"
    }
  ]
}
{% endschema %}