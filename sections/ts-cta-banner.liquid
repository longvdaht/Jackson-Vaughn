{% comment %} TS - CTA Banner {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --cream: #fcf9ef;
    --cream-mid: #faf7ef;
    --text: #232323;
    --body-color: #2d2b27;
    --green: #36402d;
    --gold: #c29b62;
    --gold-dk: #b78c47;
    --star: #f5b857;
    --verified: #76913e;
    --border: #d8d5ce;
    --font-h: 'Petrona', serif;
    --font-b: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .cta-banner {
    background: var(--cream);
    padding: 0 16px 40px;
  }

  #shopify-section-{{ section.id }} .cta-banner__box {
    max-width: 1408px;
    margin: 0 auto;
    height: 469px;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cta-banner__bg {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .cta-banner__bg img,
  #shopify-section-{{ section.id }} .cta-banner__bg .img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .cta-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,.78) 0%, rgba(0,0,0,.38) 38%, rgba(0,0,0,.15) 55%, rgba(0,0,0,.55) 78%, rgba(0,0,0,.72) 100%);
  }

  #shopify-section-{{ section.id }} .cta-banner__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 52px;
  }

  #shopify-section-{{ section.id }} .cta-banner__left {
    max-width: 420px;
  }

  #shopify-section-{{ section.id }} .cta-banner__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-b);
    font-size: 13px;
    color: rgba(255,255,255,0.75);
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .cta-banner__meta-stars {
    color: var(--star);
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .cta-banner__heading {
    font-family: var(--font-h);
    font-size: 44px;
    font-weight: 500;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .cta-banner__body {
    font-family: var(--font-b);
    font-size: 16px;
    color: rgba(255,255,255,.82);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .btn-atc-gold {
    display: block;
    width: 100%;
    background: #d6a24c;
    color: #fff;
    font-family: var(--font-b);
    font-size: 19px;
    font-weight: 500;
    padding: 18px 24px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cta-banner__trust {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-b);
    font-size: 13px;
    color: rgba(255,255,255,.65);
    margin-top: 12px;
  }

  #shopify-section-{{ section.id }} .cta-banner__stats {
    display: flex;
    flex-direction: column;
    margin-right: 12px;
  }

  #shopify-section-{{ section.id }} .cta-stat {
    width: 186px;
    height: 126px;
    border: 1px solid rgba(255,255,255,.28);
    background: rgba(0,0,0,.48);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    padding: 0 14px;
  }

  #shopify-section-{{ section.id }} .cta-stat + .cta-stat {
    border-top: none;
  }

  #shopify-section-{{ section.id }} .cta-stat__icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cta-stat__label {
    font-family: var(--font-b);
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    line-height: 1.4;
    white-space: pre-line;
  }

  #shopify-section-{{ section.id }} .img-placeholder {
    background: #4a4540;
    color: #888;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    text-transform: uppercase;
    font-family: var(--font-b);
    width: 100%;
    height: 100%;
  }

  /* Mobile */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .cta-banner__box {
      height: auto;
      min-height: 657px;
    }

    #shopify-section-{{ section.id }} .cta-banner__inner {
      padding: 32px 20px 36px;
      flex-direction: column;
      gap: 0;
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .cta-banner__left {
      display: contents;
    }

    #shopify-section-{{ section.id }} .cta-banner__meta {
      order: 0;
    }

    #shopify-section-{{ section.id }} .cta-banner__heading {
      order: 1;
      font-size: 34px;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .cta-banner__body {
      order: 2;
      font-size: 15px;
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .cta-banner__stats {
      order: 3;
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: center;
      align-self: center;
      margin: 20px 0;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .cta-stat {
      width: 99px;
      height: 97px;
    }

    #shopify-section-{{ section.id }} .cta-stat + .cta-stat {
      border-top: 1px solid rgba(255,255,255,.28);
      border-left: none;
    }

    #shopify-section-{{ section.id }} .cta-banner__cta-wrap {
      order: 4;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .cta-banner__trust {
      order: 5;
    }

    #shopify-section-{{ section.id }} .cta-banner__overlay {
      background: linear-gradient(to bottom, rgba(0,0,0,.55) 0%, rgba(0,0,0,.72) 100%);
    }
  }
</style>

<section class="cta-banner" id="ts-cta-banner-{{ section.id }}">
  <div class="cta-banner__box">

    <!-- Background Image -->
    <div class="cta-banner__bg">
      {% if section.settings.bg_image %}
        {{ section.settings.bg_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      {% else %}
        <div class="img-placeholder">Background Image</div>
      {% endif %}
    </div>

    <!-- Overlay -->
    <div class="cta-banner__overlay"></div>

    <!-- Inner content -->
    <div class="cta-banner__inner">

      <!-- Left: Content -->
      <div class="cta-banner__left">
        <div class="cta-banner__meta">
          <span class="cta-banner__meta-stars">★★★★★</span>
          {{ section.settings.rating_text }}
        </div>
        <h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
        <div class="cta-banner__body">{{ section.settings.body }}</div>
        <div class="cta-banner__cta-wrap">
          {% if section.settings.cta_url != blank %}
            <a href="{{ section.settings.cta_url }}" class="btn-atc-gold">{{ section.settings.cta_text }}</a>
          {% else %}
            <button class="btn-atc-gold">{{ section.settings.cta_text }}</button>
          {% endif %}
          <div class="cta-banner__trust">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1L2 3.5V7C2 9.8 4.2 12.3 7 13C9.8 12.3 12 9.8 12 7V3.5L7 1Z" stroke="rgba(255,255,255,0.65)" stroke-width="1.2" fill="none"/></svg>
            Easy Returns &nbsp;·&nbsp; Secure Checkout &nbsp;·&nbsp; Free Shipping Over $60
          </div>
        </div>
      </div>

      <!-- Right: Stats -->
      <div class="cta-banner__stats">

        <!-- Stat 1: Star rating -->
        <div class="cta-stat">
          <svg class="cta-stat__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 1L13.9 7.6L21 8.6L16 13.4L17.2 21L11 17.6L4.8 21L6 13.4L1 8.6L8.1 7.6L11 1Z" fill="#c29b62"/>
          </svg>
          <div class="cta-stat__label">{{ section.settings.stat_1_label }}</div>
        </div>

        <!-- Stat 2: Location pin -->
        <div class="cta-stat">
          <svg class="cta-stat__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 2C8.2 2 6 4.2 6 7C6 10.5 11 18 11 18C11 18 16 10.5 16 7C16 4.2 13.8 2 11 2Z" fill="#c29b62" opacity="0.9"/>
            <circle cx="11" cy="7" r="2.5" fill="#36402d"/>
          </svg>
          <div class="cta-stat__label">{{ section.settings.stat_2_label }}</div>
        </div>

        <!-- Stat 3: Hand-poured stamp -->
        <div class="cta-stat">
          <svg class="cta-stat__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="13" width="16" height="6" rx="1" fill="#c29b62" opacity="0.9"/>
            <path d="M7 13V9C7 7.3 9 4 11 3C13 4 15 7.3 15 9V13" stroke="#c29b62" stroke-width="1.5" fill="none"/>
            <path d="M9 9.5C9 8.7 9.9 7 11 6.5C12.1 7 13 8.7 13 9.5" stroke="#c29b62" stroke-width="1" fill="none"/>
          </svg>
          <div class="cta-stat__label">{{ section.settings.stat_3_label }}</div>
        </div>

      </div><!-- /cta-banner__stats -->
    </div><!-- /cta-banner__inner -->
  </div><!-- /cta-banner__box -->
</section>

{% schema %}
{
  "name": "TS - CTA Banner",
  "tag": "section",
  "class": "ts-cta-banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "rating_text", "label": "Rating Text", "default": "4.9 Stars · 2,400+ Happy Homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring Jackson Vaughn Into Your Home" },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "Hand-poured since 2000. Ready to burn the moment it arrives. Join 2,400+ houses that smell like a home." },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Add to Cart" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 Label", "default": "Rated 4.9/5\nBy 2,400+" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 Label", "default": "5 Texas Retail Locations" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 Label", "default": "Hand-Poured\nSince 2000" }
  ],
  "presets": [
    {
      "name": "TS - CTA Banner"
    }
  ]
}
{% endschema %}