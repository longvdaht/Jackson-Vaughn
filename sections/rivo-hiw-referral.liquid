{%- comment -%} Native referral How It Works section. No Rivo app block required.
Simple numbered-circle layout (Mack Weldon style) — no step photography. {%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Dosis:wght@400;500;600;700&display=swap');

  .jv-ref-hiw-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background: #1D1A16;
    color: #FAF6EC;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  .jv-ref-hiw-{{ section.id }} * {
    box-sizing: border-box;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__header {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__eyebrow {
    margin: 0 0 16px;
    color: #C79A4B;
    font-family: "Petrona", serif;
    font-size: 16px;
    font-style: italic;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 1.3;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__title {
    max-width: 900px;
    margin: 0 auto;
    color: #FAF6EC;
    font-family: "Petrona", serif;
    font-size: clamp(38px, 4.4vw, 58px);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__intro {
    max-width: 640px;
    margin: 22px auto 0;
    color: rgba(250, 246, 236, .72);
    font-family: "Dosis", sans-serif;
    font-size: 17px;
    line-height: 1.65;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__intro p {
    margin: 0;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    width: min(100%, 980px);
    margin: 64px auto 0;
    padding: 0 24px;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 0 28px;
    text-align: center;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 33px;
    left: calc(50% + 33px);
    width: calc(100% - 66px);
    height: 1px;
    background: rgba(250, 246, 236, .22);
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    margin: 0 0 26px;
    border: 1px solid rgba(250, 246, 236, .4);
    border-radius: 50%;
    color: #FAF6EC;
    font-family: "Petrona", serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__step-title {
    margin: 0 0 10px;
    color: #FAF6EC;
    font-family: "Petrona", serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -.01em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__description {
    max-width: 260px;
    margin: 0;
    color: rgba(250, 246, 236, .72);
    font-family: "Dosis", sans-serif;
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 880px) {
    .jv-ref-hiw-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__header {
      padding: 0 20px;
    }

    .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__intro {
      margin-top: 18px;
      font-size: 16px;
    }

    .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__steps {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 44px;
      padding: 0 20px;
    }

    .jv-ref-hiw-{{ section.id }} .jv-ref-hiw__step::after {
      display: none;
    }
  }
</style>

<section class="jv-ref-hiw-{{ section.id }}" aria-labelledby="jv-ref-hiw-title-{{ section.id }}">
  <header class="jv-ref-hiw__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="jv-ref-hiw__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="jv-ref-hiw__title" id="jv-ref-hiw-title-{{ section.id }}">
      {{ section.settings.heading | escape }}
    </h2>
    {%- if section.settings.intro != blank -%}
      <div class="jv-ref-hiw__intro">{{ section.settings.intro }}</div>
    {%- endif -%}
  </header>

  <div class="jv-ref-hiw__steps">
    <article class="jv-ref-hiw__step">
      <span class="jv-ref-hiw__number" aria-hidden="true">{{ section.settings.step_1_number | escape }}</span>
      <h3 class="jv-ref-hiw__step-title">{{ section.settings.step_1_title | escape }}</h3>
      <p class="jv-ref-hiw__description">{{ section.settings.step_1_description | escape }}</p>
    </article>

    <article class="jv-ref-hiw__step">
      <span class="jv-ref-hiw__number" aria-hidden="true">{{ section.settings.step_2_number | escape }}</span>
      <h3 class="jv-ref-hiw__step-title">{{ section.settings.step_2_title | escape }}</h3>
      <p class="jv-ref-hiw__description">{{ section.settings.step_2_description | escape }}</p>
    </article>

    <article class="jv-ref-hiw__step">
      <span class="jv-ref-hiw__number" aria-hidden="true">{{ section.settings.step_3_number | escape }}</span>
      <h3 class="jv-ref-hiw__step-title">{{ section.settings.step_3_title | escape }}</h3>
      <p class="jv-ref-hiw__description">{{ section.settings.step_3_description | escape }}</p>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Referral: How It Works v2",
  "class": "jv-ref-hiw-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Refer a friend" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give a free candle. Get 100 points." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Share something they’ll love. When your friend orders through your link, you both get rewarded.</p>" },

    { "type": "header", "content": "Step 1" },
    { "type": "text", "id": "step_1_number", "label": "Number", "default": "1" },
    { "type": "text", "id": "step_1_title", "label": "Title", "default": "Share your link" },
    { "type": "textarea", "id": "step_1_description", "label": "Description", "default": "Send your personal referral link to a friend." },

    { "type": "header", "content": "Step 2" },
    { "type": "text", "id": "step_2_number", "label": "Number", "default": "2" },
    { "type": "text", "id": "step_2_title", "label": "Title", "default": "They get a free candle" },
    { "type": "textarea", "id": "step_2_description", "label": "Description", "default": "They buy any candle or bundle and get another candle free." },

    { "type": "header", "content": "Step 3" },
    { "type": "text", "id": "step_3_number", "label": "Number", "default": "3" },
    { "type": "text", "id": "step_3_title", "label": "Title", "default": "You get 100 points" },
    { "type": "textarea", "id": "step_3_description", "label": "Description", "default": "Once their qualifying order is complete, 100 points are added to your account." },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Top padding", "min": 0, "max": 160, "step": 8, "default": 88, "unit": "px" },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "default": 88, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 0, "max": 120, "step": 8, "default": 56, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 0, "max": 120, "step": 8, "default": 56, "unit": "px" }
  ],
  "presets": [
    { "name": "Referral: How It Works" }
  ]
}
{% endschema %}