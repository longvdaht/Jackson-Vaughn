{% comment %} TS - FAQ {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --cream: #fcf9ef;
    --cream-mid: #faf7ef;
    --text: #232323;
    --body-color: #2d2b27;
    --green: #36402d;
    --gold: #c29b62;
    --gold-dk: #b78c47;
    --star: #f5b857;
    --verified: #76913e;
    --border: #d8d5ce;
    --font-h: 'Petrona', serif;
    --font-b: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .faq-section {
    background: var(--cream);
    padding: 0 16px 0;
  }

  #shopify-section-{{ section.id }} .faq-section__box {
    max-width: 1408px;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-top: none;
    padding: 36px;
  }

  #shopify-section-{{ section.id }} .eyebrow-single {
    width: 48px;
    height: 2px;
    background: var(--gold-dk);
    border-radius: 1px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .faq-section__heading {
    font-family: var(--font-h);
    font-size: 36px;
    font-weight: 500;
    margin-bottom: 28px;
    color: var(--text);
  }

  #shopify-section-{{ section.id }} .faq-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 60px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .faq-section__item {
    border: 1px solid var(--border);
  }

  #shopify-section-{{ section.id }} .faq-section__btn {
    width: 100%;
    height: 73px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    gap: 12px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-b);
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text);
  }

  #shopify-section-{{ section.id }} .faq-section__answer {
    display: none;
    padding: 0 18px 16px;
    font-family: var(--font-b);
    font-size: 14px;
    color: rgba(45,43,39,0.7);
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .faq-section__answer.open {
    display: block;
  }

  #shopify-section-{{ section.id }} .faq-section__answer p {
    margin: 0 0 8px;
  }

  #shopify-section-{{ section.id }} .accordion-icon {
    width: 25px;
    height: 25px;
    border-radius: 50%;
    border: 1.5px solid #b8b4ae;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    color: #6b6860;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .faq-section__cta {
    max-width: 555px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .btn-atc {
    display: block;
    width: 100%;
    background: var(--green);
    color: #fff;
    font-family: var(--font-b);
    font-size: 19px;
    font-weight: 500;
    padding: 18px 24px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    text-align: center;
    text-transform: uppercase;
  }

  /* Mobile */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq-section__box {
      padding: 20px 0 24px;
    }

    #shopify-section-{{ section.id }} .eyebrow-single {
      margin-left: 16px;
    }

    #shopify-section-{{ section.id }} .faq-section__heading {
      padding: 0 16px;
      margin-bottom: 20px;
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .faq-section__grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .faq-section__item {
      border-left: none;
      border-right: none;
    }

    #shopify-section-{{ section.id }} .faq-section__item + .faq-section__item {
      border-top: none;
    }

    #shopify-section-{{ section.id }} .faq-section__btn {
      height: 56px;
      font-size: 16px;
      font-weight: 500;
      text-transform: none;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .faq-section__cta {
      padding: 0 16px;
      max-width: 100%;
    }
  }
</style>

<section class="faq-section" id="ts-faq-{{ section.id }}">
  <div class="faq-section__box">

    <div class="eyebrow-single"></div>
    <h2 class="faq-section__heading">{{ section.settings.heading }}</h2>

    <div class="faq-section__grid" id="faq-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="faq-section__item" {{ block.shopify_attributes }}>
          <button class="faq-section__btn" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="accordion-icon">+</span>
          </button>
          <div class="faq-section__answer">
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="faq-section__cta">
      {% if section.settings.cta_url != blank %}
        <a href="{{ section.settings.cta_url }}" class="btn-atc">{{ section.settings.cta_text }}</a>
      {% else %}
        <button class="btn-atc">{{ section.settings.cta_text }}</button>
      {% endif %}
    </div>

  </div>
</section>

<script>
(function() {
  var sid = '{{ section.id }}';
  document.querySelectorAll('#faq-grid-' + sid + ' .faq-section__btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var answer = btn.nextElementSibling;
      var icon = btn.querySelector('.accordion-icon');
      var isOpen = answer.classList.contains('open');
      answer.classList.toggle('open', !isOpen);
      if (icon) icon.textContent = isOpen ? '+' : '−';
      btn.setAttribute('aria-expanded', !isOpen);
    });
  });
})();
</script>

{% schema %}
{
  "name": "TS - FAQ",
  "tag": "section",
  "class": "ts-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Add to Cart" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "limit": 20,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TS - FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What does Texas Spring smell like?",
            "answer": "<p>Texas Spring is a fresh floral fragrance inspired by Texas wildflowers in bloom. Notes of bluebonnets, clean air, and soft greenery — it smells like a spring morning in the Texas Hill Country.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does the candle burn?",
            "answer": "<p>Our 16oz jar burns for up to 60 hours, and our 9oz jar for up to 40 hours. Burn times may vary based on environment and wick care.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What kind of wax do you use?",
            "answer": "<p>We use 100% premium soy wax sourced from American farmers. Soy wax burns cleaner, longer, and carries fragrance more beautifully than paraffin alternatives.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How strong is the scent throw?",
            "answer": "<p>Texas Spring has a strong, room-filling scent throw. Within 20–30 minutes, the fragrance will fill most rooms. Our hand-poured process ensures maximum fragrance load in every pour.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer returns?",
            "answer": "<p>Yes — we offer easy 30-day returns on unopened items. If there's ever an issue with your candle, reach out to our team and we'll make it right.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How fast does it ship?",
            "answer": "<p>Orders are processed and shipped within 1 business day. Most customers receive their candles within 2–4 business days. Expedited shipping is available at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}