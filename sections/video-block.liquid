{{ 'video-section.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  ============================================================================
  METAOBJECT-DRIVEN CONTENT  (custom.video_section)
  ----------------------------------------------------------------------------
  Every value = vmo.<field_key>.value | default: section.settings.<id>
  If a metaobject field is set, it wins; otherwise the theme-editor value is
  used. A WRONG guessed key just falls back to section.settings (no breakage),
  so verify the keys marked "VERIFY" against the metaobject definition in Admin
  and fix them here in this single block if needed.
  ============================================================================
{%- endcomment -%}
{%- liquid
  # ---- Resolve the metaobject (section picker → product → page) ----
  assign vmo = nil
  if section.settings.video_section != blank
    assign vmo = section.settings.video_section
  elsif product.metafields.custom.product_video_section != blank
    assign vmo = product.metafields.custom.product_video_section.value
  elsif page.metafields.custom.product_video_section != blank
    assign vmo = page.metafields.custom.product_video_section.value
  endif

  # ---- General / layout ----
  assign container            = vmo.section_width.value        | default: section.settings.container
  assign spotlight_bg         = vmo.background_color.value     | default: section.settings.spotlight_bg
  assign spotlight_bg_gradient = section.settings.spotlight_bg_gradient
  assign spotlight_bg_image   = section.settings.spotlight_bg_image
  if vmo.background_image.value != blank
    assign spotlight_bg_image = vmo.background_image.value
    if spotlight_bg_image.image != blank
      assign spotlight_bg_image = spotlight_bg_image.image
    endif
  endif

  # ---- Section title / description (above the video) ----
  assign video_block_title = vmo.title.value               | default: section.settingsvideo_block_title
  assign color_title       = vmo.title_color.value         | default: section.settings.color_title
  assign fontsize_title    = vmo.title_font_size.value      | default: section.settings.fontsize_title
  assign fontsize_title_mb = vmo.title_font_size_mobile.value | default: section.settings.fontsize_title_mb
  assign margin_bottom_title = vmo.title_margin_bottom.value | default: section.settings.margin_bottom_title
  assign video_block_des   = vmo.description.value          | default: section.settings.video_block_des
  assign color_des         = vmo.description_color.value     | default: section.settings.color_des
  assign fontsize_des      = vmo.description_font_size.value  | default: section.settings.fontsize_des
  assign title_align       = vmo.alignment.value            | default: section.settings.title_align

  # ---- Video ----
  assign style_video     = vmo.style_video.value          | default: section.settings.style_video
  assign url_mp4         = vmo.url_mp4_video.value         | default: section.settings.url_mp4         
  assign url_mp4_mb      = vmo.url_mp4_mobile_video.value  | default: section.settings.url_mp4_mb        
  assign video_height    = vmo.video_height.value          | default: section.settings.video_height
  assign video_height_mb = vmo.video_height_on_mobile.value | default: section.settings.video_height_mb
  assign position_icon   = vmo.position_icon.value         | default: section.settings.position_icon
  assign video_alt       = vmo.video_alt_text.value        | default: section.settings.description

  # ---- Cover image (metaobject File → normalise to an image object) ----
  assign cover_image = cover_image
  if vmo.cover_image.value != blank
    assign cover_image = vmo.cover_image.value
    if cover_image.image != blank
      assign cover_image = cover_image.image
    endif
  endif

  # ---- Auto play (boolean — never use `default`, false is a real value) ----
  assign auto_video = section.settings.autoplay
  if vmo != blank and vmo.auto_play_video != blank
    assign auto_video = vmo.auto_play_video.value
  endif

  # ---- Full width (boolean) ----
  assign full_width = section.settings.full_width
  if vmo != blank and vmo.make_section_full_width != blank
    assign full_width = vmo.make_section_full_width.value
  endif

  # ---- Content box (overlay) ----
  assign heading              = vmo.content_title.value                 | default: section.settings.heading
  assign heading_font_size    = vmo.content_title_font_size.value       | default: section.settings.font_size_heading
  assign heading_font_size_mb = vmo.content_title_font_size_mobile.value | default: section.settings.font_size_heading_mb
  assign margin_bottom_heading = vmo.content_title_spacing_bottom.value | default: section.settings.margin_bottom_heading
  assign heading_color        = vmo.content_title_color.value           | default: section.settings.color_heading
  assign text                 = vmo.content_description.value           | default: section.settings.text
  assign des_font_size        = vmo.content_description_font_size.value  | default: section.settings.font_size_des
  assign des_font_size_mb     = vmo.content_description_font_size_mobile.value | default: section.settings.font_size_des_mb
  assign margin_bottom_des    = vmo.description_spacing_bottom.value     | default: section.settings.margin_bottom_des
  assign des_color            = vmo.content_description_color.value      | default: section.settings.color_des_content
  assign content_width        = vmo.content_max_width.value             | default: section.settings.content_width
  assign align                = vmo.content_alignment.value             | default: section.settings.align
  assign position             = vmo.content_position.value              | default: section.settings.position

  # ---- Button ----
  assign btn_text     = vmo.button_text.value  | default: section.settings.btn_text
  assign link         = vmo.button_link.value  | default: section.settings.link
  assign button_width = vmo.button_width.value | default: section.settings.button_width
  # Button colours — VERIFY these keys against the metaobject definition
  assign button_color                     = vmo.button_color.value                     | default: section.settings.button_color
  assign button_border                    = vmo.button_border_color.value              | default: section.settings.button_border
  assign button_background                = vmo.button_background_color.value           | default: section.settings.button_background
  assign button_background_gradient       = vmo.button_background_gradient.value        | default: section.settings.button_background_gradient
  assign button_color_hover               = vmo.button_hover_active_color.value         | default: section.settings.button_color_hover
  assign button_border_hover              = vmo.button_hover_active_border_color.value  | default: section.settings.button_border_hover
  assign button_background_hover          = vmo.button_hover_active_background_color.value | default: section.settings.button_background_hover
  assign button_background_gradient_hover = vmo.button_hover_active_background_gradient.value | default: section.settings.button_background_gradient_hover

  # ---- Spacing (top / bottom) — VERIFY keys ----
  assign mg_top_desktop    = vmo.spacing_top_desktop.value    | default: section.settings.mg_top_desktop
  assign mg_top_tablet     = vmo.spacing_top_tablet.value     | default: section.settings.mg_top_tablet
  assign mg_top_mobile     = vmo.spacing_top_mobile.value     | default: section.settings.mg_top_mobile
  assign mg_bottom_desktop = vmo.spacing_bottom_desktop.value | default: section.settings.mg_bottom_desktop
  assign mg_bottom_tablet  = vmo.spacing_bottom_tablet.value  | default: section.settings.mg_bottom_tablet
  assign mg_bottom_mobile  = vmo.spacing_bottom_mobile.value  | default: section.settings.mg_bottom_mobile

  # ---- Derive video id + provider from the plain URL string ----
  assign yt_id = ''
  assign vm_id = ''
  assign video_provider = 'youtube'
  assign url_video_mo    = vmo.url_video.value
  assign url_video_mo_mb = vmo.url_video_mobile.value
  if url_video_mo != blank
    if url_video_mo contains 'youtu'
      assign video_provider = 'youtube'
      assign yt_id = url_video_mo | split: 'v=' | last | split: '&' | first | split: '/' | last
    elsif url_video_mo contains 'vimeo'
      assign video_provider = 'vimeo'
      assign vm_id = url_video_mo | split: '?' | first | split: '/' | last
    endif
  endif
  # Fallback to the theme-editor video_url object when no metaobject URL
  if url_video_mo == blank
    assign video_provider = section.settings.video_url.type
    assign yt_id = section.settings.video_url.id
    assign vm_id = section.settings.video_url.id
  endif
  # Mobile id
  assign yt_id_mb = ''
  assign vm_id_mb = ''
  assign has_video_mb = false
  if url_video_mo_mb != blank
    assign has_video_mb = true
    if url_video_mo_mb contains 'youtu'
      assign yt_id_mb = url_video_mo_mb | split: 'v=' | last | split: '&' | first | split: '/' | last
    elsif url_video_mo_mb contains 'vimeo'
      assign vm_id_mb = url_video_mo_mb | split: '?' | first | split: '/' | last
    endif
  elsif section.settings.video_url_mb != blank
    assign has_video_mb = true
    assign yt_id_mb = section.settings.video_url_mb.id
    assign vm_id_mb = section.settings.video_url_mb.id
  endif

  if section.settings.video_url_mb == blank and section.settings.video_url == blank and section.settings.url_mp4 == blank and section.settings.url_mp4_mb == blank
    assign no_video = true
  endif

  # ---- Helpers for noscript link + deferred-media id ----
  assign video_href = url_video_mo | default: section.settings.video_url
  if video_provider == 'vimeo'
    assign video_media_id = vm_id
  else
    assign video_media_id = yt_id
  endif
-%}
<div class="{% if vmo == blank %}{% if no_video %}hidden{% endif %}{% endif %} video-section section-block-{{section.id}}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}" allow-transparent-header data-loader-script="{%- if autoVideo -%}{{ 'autoplay-video.js' | asset_url }}{%- else -%}{{ 'deferred-media.js' | asset_url }}{%- endif -%}">
  <div class="{% if container == 'fullwidth' %}container-full{% elsif container == '1770' %}container-1770{% elsif container == '1170' %}container-1170{% else %}container{% endif %}">
      {% if video_block_title != blank %}
          <div class="halo-block-header text-{{ title_align }}">
              <h3 class="title{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}" style="--margin-bottom-title: {{ margin_bottom_title | append: 'px' }}">
                  <span class="text">
                  {{ video_block_title }}
                  </span>
              </h3>
              {% if video_block_des != blank %}
                  <div class="subtext-video rte{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
                      {{ video_block_des }}
                  </div>        
              {% endif %}
          </div>
      {% endif %}
      <noscript>
        <div class="video-section__media"
          {% if cover_image != blank %} style="padding-bottom: {{ 1 | divided_by: cover_image.aspect_ratio | times: 100 }}%;"{% endif %}
        >
          <a {% if video_href == blank %} role="link" aria-disabled="true"{% else %} href="{{ video_href }}"{% endif %} class="video-section__poster media media--transparent media--landscape{% if cover_image == blank %} video-section__placeholder{% endif %}">
            {%- if cover_image != blank -%}
              <img
                srcset="{%- if cover_image.width >= 375 -%}{{ cover_image | img_url: '375x' }} 375w,{%- endif -%}
                  {%- if cover_image.width >= 750 -%}{{ cover_image | img_url: '750x' }} 750w,{%- endif -%}
                  {%- if cover_image.width >= 1100 -%}{{ cover_image | img_url: '1100x' }} 1100w,{%- endif -%}
                  {%- if cover_image.width >= 1500 -%}{{ cover_image | img_url: '1500x' }} 1500w,{%- endif -%}
                  {%- if cover_image.width >= 1780 -%}{{ cover_image | img_url: '1780x' }} 1780w,{%- endif -%}
                  {%- if cover_image.width >= 2000 -%}{{ cover_image | img_url: '2000x' }} 2000w,{%- endif -%}
                  {%- if cover_image.width >= 3000 -%}{{ cover_image | img_url: '3000x' }} 3000w,{%- endif -%}
                  {%- if cover_image.width >= 3840 -%}{{ cover_image | img_url: '3840x' }} 3840w,{%- endif -%}
                  {{ cover_image | img_url: 'master' }} {{ cover_image.width }}w"
                src="{{ cover_image | img_url: '1920x' }}"
                sizes="{% if full_width %}100vw{% else %}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw{% endif %}"
                alt="{{ 'sections.video.load_video' | t: description: video_alt | escape }}"
                {% unless settings.enable_layout_rtl %} loading="lazy"{% endunless %}
                width="{{ cover_image.width }}"
                height="{{ cover_image.height }}"
              >
            {%- else -%}
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            {%- endif -%}
          </a>
        </div>
      </noscript>
      <deferred-media class="video-section__media deferred-media no-js-hidden{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}" data-media-id="{{ video_media_id }}"
        {% if cover_image != blank %} style="padding-bottom: {{ video_height }}%;--video_height_mb: {{ video_height_mb }}%;"{% endif %}
      >
        <button
          id="Deferred-Poster-Modal-{{ video_media_id }}"
          class="video-section__poster media deferred-media__poster media--landscape"
          type="button"
          {% if autoVideo %}
            style="display: none"
          {% endif %}
        >
          {%- if cover_image != blank -%}
            <img
              srcset="{%- if cover_image.width >= 375 -%}{{ cover_image | img_url: '375x' }} 375w,{%- endif -%}
                {%- if cover_image.width >= 750 -%}{{ cover_image | img_url: '750x' }} 750w,{%- endif -%}
                {%- if cover_image.width >= 1100 -%}{{ cover_image | img_url: '1100x' }} 1100w,{%- endif -%}
                {%- if cover_image.width >= 1500 -%}{{ cover_image | img_url: '1500x' }} 1500w,{%- endif -%}
                {%- if cover_image.width >= 1780 -%}{{ cover_image | img_url: '1780x' }} 1780w,{%- endif -%}
                {%- if cover_image.width >= 2000 -%}{{ cover_image | img_url: '2000x' }} 2000w,{%- endif -%}
                {%- if cover_image.width >= 3000 -%}{{ cover_image | img_url: '3000x' }} 3000w,{%- endif -%}
                {%- if cover_image.width >= 3840 -%}{{ cover_image | img_url: '3840x' }} 3840w,{%- endif -%}
                {{ cover_image | img_url: 'master' }} {{ cover_image.width }}w"
              src="{{ cover_image | img_url: '1920x' }}"
              sizes="{% if full_width %}100vw{% else %}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw{% endif %}"
              alt="{{ 'sections.video.load_video' | t: description: video_alt | escape }}"
              {% unless settings.enable_layout_rtl %} loading="lazy"{% endunless %}
              width="{{ cover_image.width }}"
              height="{{ cover_image.height }}"
            >
          {%- else -%}
            <div class="not_img" style="--height_not_img: 100%">
              {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
          {%- endif -%}
          <span class="deferred-media__poster-button motion-reduce icon-position-{{position_icon}}{% if heading != blank or text != blank %} enable_content{% endif %}">
            {%- render 'icon-play' -%}
          </span>
        </button>

        {%- if heading != blank or text != blank -%}
            <div class="content-box content-box--absolute content-box--{{ position }} text-{{ align }}{% if block.settings.position == 'custom' %} custom_position{% elsif block.settings.position == 'half' %} content-box--absolute-half{% endif %}" style="--content_width:{{ content_width | append: 'px' }};{% if block.settings.position == 'custom' %}--horizontal_position: {{ block.settings.custom_horizontal }}%;--vertical_position: {{ block.settings.custom_vertical }}%;--minus_horizontal_position: -{{ block.settings.custom_horizontal }}%;--minus_vertical_position: -{{ block.settings.custom_vertical }}%{% endif %}">
                {%- if heading != blank -%}
                    <h3 class="banner-heading{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}" style="{% if settings.banner_animation == 'effect_fade_up' %}--animation-order: 1;{% endif %}--heading_font_size: {{ heading_font_size | append: "px"}};--heading_font_size_mb: {{ heading_font_size_mb | append: 'px' }};--heading_color: {{ heading_color }};--margin_bottom_heading:{{margin_bottom_heading | append: 'px'}}">{{ heading }}</h3>
                {%- endif -%}
                {%- if text != blank -%}
                    <span class="banner-text{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}" style="{% if settings.banner_animation == 'effect_fade_up' %}--animation-order: 2;{% endif %}--des_font_size: {{ des_font_size | append: 'px'}};--des_font_size_mb: {{ des_font_size_mb | append: 'px'}};--des_color: {{ des_color }};--margin_bottom_des: {{ margin_bottom_des | append: 'px'}}">{{ text }}</span>
                {%- endif -%}
                {%- if btn_text != blank -%}
                    {% if settings.banner_animation == 'effect_fade_up' %}
                    <div class="scroll-trigger animate--slide-in" style="--animation-order: 3;">
                    {% endif %}
                        <a {% if link == blank %} role="link" aria-disabled="true"{% else %} href="{{ link }}"{% endif %} class="banner-button button{% if settings.banner_animation == 'effect_fade_up' %} effect_fade_up{% endif %}" style="--button_color: {{ button_color }};--button_bg: {% if button_background_gradient != blank %}{{ button_background_gradient }}{% else %}{{ button_background}}{% endif %};--button_border: {{ button_border }};--button_width: {{ button_width | append: 'px' }};--button_color_hover: {{ button_color_hover }};--button_bg_hover: {% if button_background_gradient_hover != blank %}{{ button_background_gradient_hover }}{% else %}{{ button_background_hover}}{% endif %};--button_border_hover: {{ button_border_hover}}">
                            <span>{{ btn_text | escape }}</span>
                        </a>
                    {% if settings.banner_animation == 'effect_fade_up' %}
                    </div>
                    {% endif %}
                {%- endif -%}
            </div>
        {%- endif -%}


        <{%- if autoVideo -%}div{%- else -%}template{%- endif -%}>
            {% if style_video == 'youtube' %}
                {%- if video_provider == 'youtube' -%}
                    <iframe src="https://www.youtube.com/embed/{{ yt_id }}?enablejsapi=1&modestbranding=1&autohide=1&showinfo=0&controls=0&mute=1&autoplay=1&loop=1&playlist={{ yt_id }}" class="js-youtube{% if has_video_mb %} slide-pc{% endif %}" allow="autoplay; loop; encrypted-media" allowfullscreen title="{{ video_alt | escape }}"></iframe>
                    {%- if has_video_mb -%}
                        <iframe src="https://www.youtube.com/embed/{{ yt_id_mb }}?enablejsapi=1&modestbranding=1&autohide=1&showinfo=0&controls=0&mute=1&autoplay=1&loop=1&playlist={{ yt_id_mb }}" class="js-youtube slide-mb" allow="autoplay; loop; encrypted-media" allowfullscreen title="{{ video_alt | escape }}"></iframe>
                    {%- endif -%}
                {%- else -%}
                    <iframe src="https://player.vimeo.com/video/{{ vm_id }}?autoplay=1&title=0&byline=0&portrait=0&mute=1&loop=1&autopause=0&playlist={{ vm_id }}" class="js-vimeo{% if has_video_mb %} slide-pc{% endif %}" allow="autoplay; encrypted-media" webkitallowfullscreen mozallowfullscreen allowfullscreen title="{{ video_alt | escape }}"></iframe>
                    {%- if has_video_mb -%}
                        <iframe src="https://player.vimeo.com/video/{{ vm_id_mb }}?autoplay=1&title=0&byline=0&portrait=0&mute=1&loop=1&autopause=0&playlist={{ vm_id_mb }}" class="js-vimeo slide-mb" allow="autoplay; encrypted-media" webkitallowfullscreen mozallowfullscreen allowfullscreen title="{{ video_alt | escape }}"></iframe>
                    {%- endif -%}
                {%- endif -%}
            {%- else -%}
                <video class="js-video{% if url_mp4_mb != blank %} slide-pc{% endif %}" muted playsinline preload="none" autoplay loop controls>
                    <source type="video/mp4" src="{{ url_mp4 }}">
                </video>
                {%- if url_mp4_mb != blank -%}
                  <video class="js-video slide-mb" muted playsinline preload="none" autoplay loop controls>
                    <source type="video/mp4" src="{{ url_mp4_mb }}">
                  </video>
                {%- endif -%}
          {% endif %}
        </{%- if autoVideo -%}div{%- else -%}template{%- endif -%}>
      </deferred-media>
  </div>
  
</div>
<style>
    {%- comment -%}
      All style values (spotlight_bg, colours, font sizes, margins/spacing)
      are already resolved in the metaobject block at the top of this file.
    {%- endcomment -%}

    {% if spotlight_bg_image != blank %}
        .section-block-{{section.id}}{
            background: url({{ spotlight_bg_image | img_url: '1920x' }});
            background-repeat: repeat-x;
            background-size: cover;
        }
        .section-block-{{section.id}} .halo-block-header .title .text {
            background-color: transparent;
        }
    {% else %}
        .section-block-{{section.id}},
        .section-block-{{section.id}} .halo-block-header .title .text {
            background: {% if spotlight_bg_gradient != blank %}{{ spotlight_bg_gradient }}{% else %}{{ spotlight_bg }}{% endif %};
        }
    {% endif %}

    .section-block-{{section.id}} .halo-block-header .title:before {
        display: none;
    }

    .section-block-{{section.id}} .halo-block-header .title {
        color: {{ color_title }};
        font-size: {{ fontsize_title | append: 'px' }};
        margin-bottom: {{ margin_bottom_title | append: 'px' }};
    }

    .section-block-{{section.id}} .halo-block-header .rte {
        color: {{ color_des }};
        font-size: {{ fontsize_des | append: 'px' }};
    }

    @media (min-width: 1200px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_desktop | append: 'px' }};
            padding-bottom: {{ mg_bottom_desktop | append: 'px' }};
        }
    }

    @media (min-width: 768px) and (max-width: 1199px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_tablet | append: 'px' }};
            padding-bottom: {{ mg_bottom_tablet | append: 'px' }};
        }
    }

    @media (max-width: 1024px) {
        {% if spotlight_bg_image != blank %}
            .section-block-{{section.id}}{
                background-position: center top;
            }
        {% endif %}
    }

    @media (max-width: 767px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_mobile | append: 'px' }};
            padding-bottom: {{ mg_bottom_mobile | append: 'px' }};
        }

        .section-block-{{section.id}} .halo-block-header .title {
            font-size: {{ fontsize_title_mb | append: 'px' }};
        }
    }
</style>

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "settings": [
    {
        "type": "header",
        "content": "t:settings_schema.general.name"
    },
    {
        "type": "select",
        "id": "container",
        "label": "t:sections.layout.container.option",
        "default": "container",
        "options": [
            {
                "value": "container",
                "label": "t:sections.layout.container.option1"
            },
            {
                "value": "1170",
                "label": "t:sections.layout.container.option4"
            },
            {
                "value": "1770",
                "label": "t:sections.layout.container.option3"
            },
            {
                "value": "fullwidth",
                "label": "t:sections.layout.container.option2"
            }
        ]
    },
    {
        "type" : "color",
        "id" : "spotlight_bg",
        "label" : "t:settings_schema.colors.settings.colors_name.background_color",
        "default" : "#fff"
    },
    {
        "type" : "color_background",
        "id" : "spotlight_bg_gradient",
        "label" : "t:settings_schema.colors.settings.colors_name.background_color_gradient"
    },
    {
        "type" : "image_picker",
        "id" : "spotlight_bg_image",
        "label" : "t:settings_schema.colors.settings.colors_name.background_image"
    },
    {
        "type": "text",
        "id": "video_block_title",
        "label": "t:sections.image-banner.blocks.image.settings.content.label__1",
        "default": "Video"
    },
    {
        "type" : "color",
        "id" : "color_title",
        "label": "t:sections.layout.color.color_title",
        "default" : "#232323"
    },
    {
        "type": "range",
        "id": "fontsize_title",
        "label": "t:sections.layout.fontsize.fontsize_title.label",
        "min": 10,
        "max": 50,
        "step": 1,
        "unit": "t:sections.layout.fontsize.fontsize_title.unit",
