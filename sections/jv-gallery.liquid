{% comment %} JV - Gallery {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>

{%- liquid
  # Half-gutter (px) applied to each side of a slide -> 2x this between images
  assign gutter = 6
  assign gutter_full = gutter | times: 2
  # Side padding used for arrow positioning (px)
  assign edge = 40
-%}

<style>
  #shopify-section-{{ section.id }} {
    --gl-bg: {{ section.settings.background_color | default: '#FBF3EC' }};
    --gl-text: {{ section.settings.heading_color | default: '#2C2622' }};
    --gl-radius: {{ section.settings.image_radius | default: 4 }}px;
    --gl-ratio: {{ section.settings.image_ratio | default: '3 / 4' }};
    --gl-edge: {{ edge }}px;
    --gl-per-mobile: {{ section.settings.per_view_mobile | default: 1.8 }};
    --font-heading: 'Petrona', serif;
    --font-body: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .jv-gl {
    background: var(--gl-bg);
    padding: {{ section.settings.padding_top | default: 56 }}px 0
      {{ section.settings.padding_bottom | default: 56 }}px;
    font-family: var(--font-body);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .jv-gl-heading {
    font-family: var(--font-heading);
    font-weight: normal;
    font-size: {{ section.settings.heading_size | default: 30 }}px;
    line-height: 1.2;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    text-align: center;
    color: var(--gl-text);
    margin: 0 0 {{ section.settings.heading_gap | default: 44 }}px;
    padding: 0 var(--gl-edge);
  }

  /* ── Slider shell ── */
  #shopify-section-{{ section.id }} .jv-gl-slider {
    position: relative;
  }

  /* Before Slick inits: show items in a row so there's no flash of stacked images */
  #shopify-section-{{ section.id }} .jv-gl-track:not(.slick-initialized) {
    display: flex;
    gap: {{ gutter_full }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .jv-gl-track:not(.slick-initialized) .jv-gl-item {
    flex: 0 0 calc((100% - ({{ section.settings.per_view_desktop | default: 5 | minus: 1 }} * {{ gutter_full }}px)) / {{ section.settings.per_view_desktop | default: 5 }});
  }

  /* Gutter between slides (Slick) */
  #shopify-section-{{ section.id }} .jv-gl-track .slick-list {
    margin: 0 -{{ gutter }}px;
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-slide {
    padding: 0 {{ gutter }}px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .jv-gl-item {
    position: relative;
    aspect-ratio: var(--gl-ratio);
    overflow: hidden;
    border-radius: var(--gl-radius);
    background: {{ section.settings.heading_color | default: '#2C2622' }}0D;
    display: block;
  }

  #shopify-section-{{ section.id }} .jv-gl-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #shopify-section-{{ section.id }} .jv-gl-item--link:hover img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .jv-gl-item .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  /* ── Slick arrows ── */
  #shopify-section-{{ section.id }} .jv-gl-track .slick-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--gl-bg);
    color: var(--gl-text);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    display: flex !important;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-arrow:hover {
    background: var(--gl-text);
    color: var(--gl-bg);
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-arrow svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-prev {
    left: calc(var(--gl-edge) - 22px);
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-next {
    right: calc(var(--gl-edge) - 22px);
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-arrow.slick-disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Slick dots ── */
  #shopify-section-{{ section.id }} .jv-gl-track .slick-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-dots li button {
    font-size: 0;
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--gl-text);
    opacity: 0.3;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .jv-gl-track .slick-dots li.slick-active button {
    opacity: 1;
  }

  /* Grab cursor while dragging */
  #shopify-section-{{ section.id }} .jv-gl-track.slick-initialized {
    cursor: grab;
  }
  #shopify-section-{{ section.id }} .jv-gl-track.slick-initialized:active {
    cursor: grabbing;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .jv-gl {
      padding: {{ section.settings.padding_top_mobile | default: 40 }}px 0
        {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    }
    #shopify-section-{{ section.id }} .jv-gl-heading {
      font-size: {{ section.settings.heading_size_mobile | default: 26 }}px;
      letter-spacing: 2px;
      margin-bottom: 28px;
    }
    #shopify-section-{{ section.id }} .jv-gl-slider {
      padding-left: 6px;
    }
    #shopify-section-{{ section.id }} .jv-gl-track .slick-list {
      margin: 0;
    }
    /* Fractional peek (e.g. 1.8 items) via variableWidth */
    #shopify-section-{{ section.id }} .jv-gl-track.slick-initialized .slick-slide {
      width: calc(100vw / var(--gl-per-mobile));
    }
    #shopify-section-{{ section.id }} .jv-gl-track:not(.slick-initialized) {
      gap: {{ gutter_full }}px;
    }
    #shopify-section-{{ section.id }} .jv-gl-track:not(.slick-initialized) .jv-gl-item {
      flex: 0 0 calc((100% - ({{ section.settings.per_view_mobile | default: 1.8 | minus: 1 }} * {{ gutter_full }}px)) / {{ section.settings.per_view_mobile | default: 1.8 }});
    }
  }
</style>

<div class="jv-gl">
  {%- if section.settings.heading != blank -%}
    <h2 class="jv-gl-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div
      class="jv-gl-slider"
      {% if section.settings.block_layout == 'slider' %}
        data-loader-script="{{ 'halo.jv-gallery.js' | asset_url }}"
      {% endif %}
    >
      <div
        class="jv-gl-track"
        {% if section.settings.block_layout == 'slider' %}
          data-jv-gallery-slider
          data-show="{{ section.settings.per_view_desktop | default: 5 }}"
          data-show-tablet="{{ section.settings.per_view_tablet | default: 3 }}"
          data-show-mobile="{{ section.settings.per_view_mobile | default: 2 }}"
          data-center="{{ section.settings.enable_center }}"
          data-arrows="{{ section.settings.show_arrows }}"
          data-dots="{{ section.settings.show_dots }}"
          data-autoplay="{{ section.settings.autoplay }}"
          data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          <div class="jv-gallery-item">
            {%- assign is_link = false -%}
            {%- if block.settings.link != blank -%}{%- assign is_link = true -%}{%- endif -%}

            <{% if is_link %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
              class="jv-gl-item{% if is_link %} jv-gl-item--link{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 768px) 50vw, 20vw',
                    widths: '300, 450, 600, 900',
                    alt: block.settings.image.alt
                  | default: section.settings.heading
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </{% if is_link %}a href="{{ block.settings.link }}"{% else %}div{% endif %}>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "JV - Gallery",
  "tag": "section",
  "class": "jv-section-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Home To Yours"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "block_layout",
      "label": "Layout",
      "default": "slider",
      "options": [
        { "value": "slider", "label": "Slider (drag / swipe)" },
        { "value": "grid", "label": "Static row" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_center",
      "label": "Center mode (desktop)",
      "info": "Centers the active item with a peek of neighbours on both sides.",
      "default": true
    },
    {
      "type": "range",
      "id": "per_view_desktop",
      "label": "Images per view (desktop)",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "per_view_tablet",
      "label": "Images per view (tablet)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "per_view_mobile",
      "label": "Images per view (mobile)",
      "info": "Use a fractional value (e.g. 1.8) to peek the next image.",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 1.8
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3 / 4",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait tall (4:5)" },
        { "value": "2 / 3", "label": "Portrait taller (2:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF3EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / arrow color",
      "default": "#2C2622"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "JV - Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
