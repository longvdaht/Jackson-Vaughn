{% comment %} JV - Gallery {% endcomment %}
{%- liquid
  # Content source: product metafield metaobject -> section settings (fallback).
  # Metafield: product.metafields.custom.product_gallery_section
  # Spacing (padding) is NOT in the metaobject, so it always uses section settings.
  assign mo = product.metafields.custom.product_gallery_section.value
  assign use_mo = false
  if mo != blank
    assign use_mo = true
  endif

  # Helper resolves: metaobject value if present, else section setting.
  if use_mo and mo.heading != blank
    assign g_heading = mo.heading
  else
    assign g_heading = section.settings.heading
  endif

  if use_mo and mo.heading_size_on_desktop != blank
    assign g_heading_size = mo.heading_size_on_desktop
  else
    assign g_heading_size = section.settings.heading_size | default: 30
  endif

  if use_mo and mo.heading_size_on_mobile != blank
    assign g_heading_size_mobile = mo.heading_size_on_mobile
  else
    assign g_heading_size_mobile = section.settings.heading_size_mobile | default: 26
  endif

  if use_mo and mo.space_below_heading != blank
    assign g_heading_gap = mo.space_below_heading
  else
    assign g_heading_gap = section.settings.heading_gap | default: 44
  endif

  if use_mo and mo.images_per_view_desktop != blank
    assign g_per_view_desktop = mo.images_per_view_desktop
  else
    assign g_per_view_desktop = section.settings.per_view_desktop | default: 5
  endif

  if use_mo and mo.edge_peek_desktop_tablet != blank
    assign g_edge_peek = mo.edge_peek_desktop_tablet
  else
    assign g_edge_peek = section.settings.edge_peek | default: 40
  endif

  if use_mo and mo.loop_infinite != blank
    assign g_loop = mo.loop_infinite
  else
    assign g_loop = section.settings.enable_loop
  endif

  if use_mo and mo.show_arrows_desktop != blank
    assign g_show_arrows = mo.show_arrows_desktop
  else
    assign g_show_arrows = section.settings.show_arrows
  endif

  if use_mo and mo.show_dots != blank
    assign g_show_dots = mo.show_dots
  else
    assign g_show_dots = section.settings.show_dots
  endif

  if use_mo and mo.autoplay != blank
    assign g_autoplay = mo.autoplay
  else
    assign g_autoplay = section.settings.autoplay
  endif

  if use_mo and mo.autoplay_speed != blank
    assign g_autoplay_speed = mo.autoplay_speed
  else
    assign g_autoplay_speed = section.settings.autoplay_speed | default: 4
  endif

  if use_mo and mo.image_aspect_ratio != blank
    assign g_image_ratio = mo.image_aspect_ratio
  else
    assign g_image_ratio = section.settings.image_ratio | default: '3 / 4'
  endif

  if use_mo and mo.image_corner_radius != blank
    assign g_image_radius = mo.image_corner_radius
  else
    assign g_image_radius = section.settings.image_radius | default: 4
  endif

  if use_mo and mo.background != blank
    assign g_bg = mo.background
  else
    assign g_bg = section.settings.background_color | default: '#FBF3EC'
  endif

  if use_mo and mo.heading_arrow_color != blank
    assign g_heading_color = mo.heading_arrow_color
  else
    assign g_heading_color = section.settings.heading_color | default: '#2C2622'
  endif

  if use_mo and mo.border_top_width != blank
    assign g_border_top_width = mo.border_top_width
  else
    assign g_border_top_width = section.settings.border_top_width
  endif

  if use_mo and mo.border_top_color != blank
    assign g_border_top_color = mo.border_top_color
  else
    assign g_border_top_color = section.settings.border_top_color | default: '#2C2622'
  endif

  # Image list: metaobject gallery_images (item = image + link) else section blocks.
  assign g_images = mo.gallery_images.value
  assign use_mo_images = false
  if use_mo and g_images != blank and g_images.size > 0
    assign use_mo_images = true
  endif

  # Derived slider vars
  assign space = 12
  assign peek = g_edge_peek | default: 40
  assign spv_desktop = g_per_view_desktop | default: 5
  assign spv_tablet = 3
  assign spv_mobile = 1.8
-%}

<style>
  #shopify-section-{{ section.id }} {
    --gl-bg: {{ g_bg }};
    --gl-text: {{ g_heading_color }};
    --gl-radius: {{ g_image_radius }}px;
    --gl-ratio: {{ g_image_ratio }};
    --gl-peek: {{ peek }}px;
  }

  #shopify-section-{{ section.id }} .jv-gl {
    background: var(--gl-bg);
    padding: {{ section.settings.padding_top | default: 56 }}px 0
      {{ section.settings.padding_bottom | default: 56 }}px;
    font-family: var(--font-body-family);
    width: 100%;
    overflow: hidden;
    {%- if g_border_top_width > 0 -%}
      border-top: {{ g_border_top_width }}px solid {{ g_border_top_color }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .jv-gl-heading {
    font-family: var(--font-family-2);
    font-weight: normal;
    font-size: {{ g_heading_size }}px;
    line-height: 1.2;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    text-align: center;
    color: var(--gl-text);
    margin: 0 0 {{ g_heading_gap }}px;
    padding: 0 24px;
  }

  /* ── Slider ── */
  #shopify-section-{{ section.id }} .jv-gl-slider {
    position: relative;
  }

  /* Bleed the swiper wider than the viewport so the outer wrapper clips the
     first & last images symmetrically (desktop/tablet). */
  #shopify-section-{{ section.id }} .jv-gl-swiper {
    overflow: hidden;
    margin: 0 calc(-1 * var(--gl-peek));
  }

  /* Fallback sizing before Swiper initialises (avoids a flash of full-width slides) */
  #shopify-section-{{ section.id }} .jv-gl-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: {{ space }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .jv-gl-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - ({{ g_per_view_desktop | default: 5 | minus: 1 }} * {{ space }}px)) / {{ g_per_view_desktop | default: 5 }});
  }

  #shopify-section-{{ section.id }} .jv-gl-slide {
    height: auto;
  }

  #shopify-section-{{ section.id }} .jv-gl-item {
    position: relative;
    aspect-ratio: var(--gl-ratio);
    overflow: hidden;
    border-radius: var(--gl-radius);
    background: {{ g_heading_color }}0D;
    display: block;
  }

  #shopify-section-{{ section.id }} .jv-gl-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #shopify-section-{{ section.id }} .jv-gl-item--link:hover img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .jv-gl-item .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  /* ── Arrows (outside the clipped swiper) ── */
  #shopify-section-{{ section.id }} .jv-gl-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--gl-bg);
    color: var(--gl-text);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow:hover {
    background: var(--gl-text);
    color: var(--gl-bg);
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow--prev {
    left: 24px;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow--next {
    right: 24px;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow.swiper-button-disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Pagination ── */
  #shopify-section-{{ section.id }} .jv-gl-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .jv-gl-pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gl-text);
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-gl-pagination .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .jv-gl {
      padding: {{ section.settings.padding_top_mobile | default: 40 }}px 0
        {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    }
    #shopify-section-{{ section.id }} .jv-gl-heading {
      font-size: {{ g_heading_size_mobile }}px;
      letter-spacing: 2px;
      margin-bottom: 28px;
      padding: 0 16px;
    }
    #shopify-section-{{ section.id }} .jv-gl-swiper {
      margin: 0;
      padding-left: 10px;
    }
    #shopify-section-{{ section.id }} .jv-gl-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(100% / {{ spv_mobile }});
    }
    #shopify-section-{{ section.id }} .jv-gl-arrow {
      display: none;
    }
  }
</style>

<div class="jv-gl">
  {%- if g_heading != blank -%}
    <h2 class="jv-gl-heading">{{ g_heading }}</h2>
  {%- endif -%}

  {%- if use_mo_images or section.blocks.size > 0 -%}
    <div class="jv-gl-slider" data-loader-script="{{ 'halo.jv-gallery.js' | asset_url }}">
      <div
        class="swiper jv-gl-swiper"
        data-jv-gallery
        data-per-desktop="{{ spv_desktop }}"
        data-per-tablet="{{ spv_tablet }}"
        data-per-mobile="{{ spv_mobile }}"
        data-space="{{ space }}"
        data-loop="{{ g_loop }}"
        data-arrows="{{ g_show_arrows }}"
        data-dots="{{ g_show_dots }}"
        data-autoplay="{{ g_autoplay }}"
        data-autoplay-speed="{{ g_autoplay_speed | times: 1000 }}"
      >
        <div class="swiper-wrapper">
          {%- if use_mo_images -%}
            {%- for item in g_images -%}
              {%- assign is_link = false -%}
              {%- if item.link != blank -%}{%- assign is_link = true -%}{%- endif -%}

              <div class="swiper-slide jv-gl-slide">
                <{% if is_link %}a href="{{ item.link }}"{% else %}div{% endif %}
                  class="jv-gl-item{% if is_link %} jv-gl-item--link{% endif %}"
                >
                  {%- if item.image != blank -%}
                    {{
                      item.image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(max-width: 768px) 60vw, 20vw',
                        widths: '300, 450, 600, 900',
                        alt: item.image.alt | default: g_heading
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </{% if is_link %}a{% else %}div{% endif %}>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- assign is_link = false -%}
              {%- if block.settings.link != blank -%}{%- assign is_link = true -%}{%- endif -%}

              <div class="swiper-slide jv-gl-slide" {{ block.shopify_attributes }}>
                <{% if is_link %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
                  class="jv-gl-item{% if is_link %} jv-gl-item--link{% endif %}"
                >
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(max-width: 768px) 60vw, 20vw',
                        widths: '300, 450, 600, 900',
                        alt: block.settings.image.alt | default: g_heading
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </{% if is_link %}a{% else %}div{% endif %}>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- if g_show_arrows -%}
        <button class="jv-gl-arrow jv-gl-arrow--prev" type="button" aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="jv-gl-arrow jv-gl-arrow--next" type="button" aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if g_show_dots -%}
        <div class="jv-gl-pagination"></div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "JV - Gallery",
  "tag": "section",
  "class": "jv-section-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Home To Yours"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "per_view_desktop",
      "label": "Images per view (desktop)",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "edge_peek",
      "label": "Edge peek (desktop/tablet)",
      "info": "How much of the first & last images is clipped at the edges.",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Loop (infinite)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3 / 4",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait tall (4:5)" },
        { "value": "2 / 3", "label": "Portrait taller (2:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF3EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / arrow color",
      "default": "#2C2622"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_top_width",
      "label": "Border top width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Border top color",
      "default": "#2C2622"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "JV - Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
