{% comment %} JV - Gallery {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap"
  rel="stylesheet"
>

{%- liquid
  # Space between images (px)
  assign space = 12

  # Edge peek (px): how much of the first & last images is clipped on desktop/tablet.
  # Achieved with a negative "bleed" margin on the swiper, clipped by the outer wrapper.
  assign peek = section.settings.edge_peek | default: 40

  assign spv_desktop = section.settings.per_view_desktop | default: 5
  # Tablet & mobile are fixed
  assign spv_tablet = 3
  assign spv_mobile = 1.8
-%}

<style>
  #shopify-section-{{ section.id }} {
    --gl-bg: {{ section.settings.background_color | default: '#FBF3EC' }};
    --gl-text: {{ section.settings.heading_color | default: '#2C2622' }};
    --gl-radius: {{ section.settings.image_radius | default: 4 }}px;
    --gl-ratio: {{ section.settings.image_ratio | default: '3 / 4' }};
    --gl-peek: {{ peek }}px;
    --font-heading: 'Petrona', serif;
    --font-body: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .jv-gl {
    background: var(--gl-bg);
    padding: {{ section.settings.padding_top | default: 56 }}px 0
      {{ section.settings.padding_bottom | default: 56 }}px;
    font-family: var(--font-body);
    width: 100%;
    overflow: hidden;
    {%- if section.settings.border_top_width > 0 -%}
      border-top: {{ section.settings.border_top_width }}px solid {{ section.settings.border_top_color | default: '#2C2622' }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .jv-gl-heading {
    font-family: var(--font-heading);
    font-weight: normal;
    font-size: {{ section.settings.heading_size | default: 30 }}px;
    line-height: 1.2;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    text-align: center;
    color: var(--gl-text);
    margin: 0 0 {{ section.settings.heading_gap | default: 44 }}px;
    padding: 0 24px;
  }

  /* ── Slider ── */
  #shopify-section-{{ section.id }} .jv-gl-slider {
    position: relative;
  }

  /* Bleed the swiper wider than the viewport so the outer wrapper clips the
     first & last images symmetrically (desktop/tablet). */
  #shopify-section-{{ section.id }} .jv-gl-swiper {
    overflow: hidden;
    margin: 0 calc(-1 * var(--gl-peek));
  }

  /* Fallback sizing before Swiper initialises (avoids a flash of full-width slides) */
  #shopify-section-{{ section.id }} .jv-gl-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: {{ space }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .jv-gl-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - ({{ section.settings.per_view_desktop | default: 5 | minus: 1 }} * {{ space }}px)) / {{ section.settings.per_view_desktop | default: 5 }});
  }

  #shopify-section-{{ section.id }} .jv-gl-slide {
    height: auto;
  }

  #shopify-section-{{ section.id }} .jv-gl-item {
    position: relative;
    aspect-ratio: var(--gl-ratio);
    overflow: hidden;
    border-radius: var(--gl-radius);
    background: {{ section.settings.heading_color | default: '#2C2622' }}0D;
    display: block;
  }

  #shopify-section-{{ section.id }} .jv-gl-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #shopify-section-{{ section.id }} .jv-gl-item--link:hover img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .jv-gl-item .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  /* ── Arrows (outside the clipped swiper) ── */
  #shopify-section-{{ section.id }} .jv-gl-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--gl-bg);
    color: var(--gl-text);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow:hover {
    background: var(--gl-text);
    color: var(--gl-bg);
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow--prev {
    left: 24px;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow--next {
    right: 24px;
  }
  #shopify-section-{{ section.id }} .jv-gl-arrow.swiper-button-disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Pagination ── */
  #shopify-section-{{ section.id }} .jv-gl-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
  }
  #shopify-section-{{ section.id }} .jv-gl-pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gl-text);
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .jv-gl-pagination .swiper-pagination-bullet-active {
    opacity: 1;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .jv-gl {
      padding: {{ section.settings.padding_top_mobile | default: 40 }}px 0
        {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    }
    #shopify-section-{{ section.id }} .jv-gl-heading {
      font-size: {{ section.settings.heading_size_mobile | default: 26 }}px;
      letter-spacing: 2px;
      margin-bottom: 28px;
      padding: 0 16px;
    }
    #shopify-section-{{ section.id }} .jv-gl-swiper {
      margin: 0;
      padding-left: 10px;
    }
    #shopify-section-{{ section.id }} .jv-gl-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(100% / {{ spv_mobile }});
    }
    #shopify-section-{{ section.id }} .jv-gl-arrow {
      display: none;
    }
  }
</style>

<div class="jv-gl">
  {%- if section.settings.heading != blank -%}
    <h2 class="jv-gl-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="jv-gl-slider" data-loader-script="{{ 'halo.jv-gallery.js' | asset_url }}">
      <div
        class="swiper jv-gl-swiper"
        data-jv-gallery
        data-per-desktop="{{ spv_desktop }}"
        data-per-tablet="{{ spv_tablet }}"
        data-per-mobile="{{ spv_mobile }}"
        data-space="{{ space }}"
        data-loop="{{ section.settings.enable_loop }}"
        data-arrows="{{ section.settings.show_arrows }}"
        data-dots="{{ section.settings.show_dots }}"
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
      >
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- assign is_link = false -%}
            {%- if block.settings.link != blank -%}{%- assign is_link = true -%}{%- endif -%}

            <div class="swiper-slide jv-gl-slide" {{ block.shopify_attributes }}>
              <{% if is_link %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
                class="jv-gl-item{% if is_link %} jv-gl-item--link{% endif %}"
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(max-width: 768px) 60vw, 20vw',
                      widths: '300, 450, 600, 900',
                      alt: block.settings.image.alt | default: section.settings.heading
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </{% if is_link %}a{% else %}div{% endif %}>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_arrows -%}
        <button class="jv-gl-arrow jv-gl-arrow--prev" type="button" aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="jv-gl-arrow jv-gl-arrow--next" type="button" aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_dots -%}
        <div class="jv-gl-pagination"></div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "JV - Gallery",
  "tag": "section",
  "class": "jv-section-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Home To Yours"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "per_view_desktop",
      "label": "Images per view (desktop)",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "edge_peek",
      "label": "Edge peek (desktop/tablet)",
      "info": "How much of the first & last images is clipped at the edges.",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Loop (infinite)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3 / 4",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait tall (4:5)" },
        { "value": "2 / 3", "label": "Portrait taller (2:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF3EC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / arrow color",
      "default": "#2C2622"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_top_width",
      "label": "Border top width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Border top color",
      "default": "#2C2622"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "JV - Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
