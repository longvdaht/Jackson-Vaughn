{% comment %} TS - Reviews {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --cream: #fcf9ef;
    --cream-mid: #faf7ef;
    --text: #232323;
    --body-color: #2d2b27;
    --green: #36402d;
    --gold: #c29b62;
    --gold-dk: #b78c47;
    --star: #f5b857;
    --verified: #76913e;
    --border: #d8d5ce;
    --font-h: 'Petrona', serif;
    --font-b: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .reviews {
    background: var(--cream);
    padding: 0 16px 0;
  }

  #shopify-section-{{ section.id }} .reviews__box {
    max-width: 1408px;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-top: none;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .reviews__strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-bottom: 1px solid var(--border);
  }

  #shopify-section-{{ section.id }} .reviews__strip-img {
    aspect-ratio: 469/192;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .reviews__strip-img + .reviews__strip-img {
    border-left: 1px solid var(--border);
  }

  #shopify-section-{{ section.id }} .reviews__strip-img img,
  #shopify-section-{{ section.id }} .reviews__strip-img .img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .reviews__content {
    padding: 36px 32px 32px;
  }

  #shopify-section-{{ section.id }} .reviews__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-b);
    font-size: 13px;
    color: #666;
    margin-bottom: 12px;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .reviews__meta-stars {
    color: var(--star);
    font-size: 15px;
  }

  #shopify-section-{{ section.id }} .reviews__heading {
    font-family: var(--font-h);
    font-size: 36px;
    font-weight: 500;
    text-align: center;
    margin-bottom: 28px;
    color: var(--text);
  }

  #shopify-section-{{ section.id }} .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }

  #shopify-section-{{ section.id }} .review-card {
    border: 1px solid var(--border);
    padding: 18px;
    background: var(--cream);
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }

  #shopify-section-{{ section.id }} .review-card__stars {
    color: var(--star);
    font-size: 14px;
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .review-card__score {
    font-family: var(--font-b);
    font-size: 13px;
    color: #777;
    font-weight: 500;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .review-card__text {
    font-family: var(--font-b);
    font-size: 14px;
    color: rgba(45,43,39,0.75);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .review-card__author {
    font-family: var(--font-b);
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
  }

  #shopify-section-{{ section.id }} .review-card__verified {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-b);
    font-size: 13px;
    color: var(--verified);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .reviews__cta {
    max-width: 555px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .btn-atc {
    display: block;
    width: 100%;
    background: var(--green);
    color: #fff;
    font-family: var(--font-b);
    font-size: 19px;
    font-weight: 500;
    padding: 18px 24px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .img-placeholder {
    background: #d0cdc4;
    color: #888;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    text-transform: uppercase;
    font-family: var(--font-b);
    width: 100%;
    height: 100%;
  }

  /* Mobile */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .reviews__strip {
      grid-template-columns: repeat(3, 105px);
      justify-content: center;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .reviews__strip-img {
      width: 105px;
      height: 148px;
      aspect-ratio: unset;
    }

    #shopify-section-{{ section.id }} .reviews__strip-img + .reviews__strip-img {
      border-left: none;
    }

    #shopify-section-{{ section.id }} .reviews__content {
      padding: 24px 16px;
    }

    #shopify-section-{{ section.id }} .reviews__meta {
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .reviews__heading {
      text-align: left;
      font-size: 30px;
    }

    #shopify-section-{{ section.id }} .reviews__grid {
      display: flex;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      gap: 12px;
      width: calc(100% + 16px);
      margin-right: -16px;
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .reviews__grid::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .review-card {
      flex: none;
      width: 254px;
      height: 174px;
      overflow: hidden;
      scroll-snap-align: start;
    }

    #shopify-section-{{ section.id }} .rev-dots {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 20px;
    }

    #shopify-section-{{ section.id }} .rev-dot {
      display: block;
      height: 2px;
      width: 30px;
      background: var(--gold-dk);
      opacity: 0.25;
      border-radius: 1px;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: width 0.2s, opacity 0.2s;
    }

    #shopify-section-{{ section.id }} .rev-dot.active {
      width: 48px;
      opacity: 1;
    }
  }

  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .rev-dots {
      display: none;
    }
  }
</style>

<section class="reviews" id="ts-reviews-{{ section.id }}">
  <div class="reviews__box">

    <!-- Photo Strip -->
    <div class="reviews__strip">
      {% assign strip_ids = 'strip_1,strip_2,strip_3' | split: ',' %}
      {% for strip_id in strip_ids %}
        <div class="reviews__strip-img">
          {% assign strip_img = section.settings[strip_id] %}
          {% if strip_img %}
            {{ strip_img | image_url: width: 1200 | image_tag: loading: 'lazy' }}
          {% else %}
            <div class="img-placeholder">Strip Photo {{ forloop.index }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <!-- Content -->
    <div class="reviews__content">
      <div class="reviews__meta">
        <span class="reviews__meta-stars">★★★★★</span>
        {{ section.settings.rating_text }}
      </div>
      <h2 class="reviews__heading">{{ section.settings.heading }}</h2>

      <!-- Review Grid -->
      <div class="reviews__grid" id="reviews-grid-{{ section.id }}">
        {% for block in section.blocks %}
          {% assign star_count = block.settings.stars | plus: 0 %}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="review-card__stars">
              {% for i in (1..star_count) %}★{% endfor %}{% for i in (star_count..4) %}☆{% endfor %}
            </div>
            <div class="review-card__score">{{ star_count }}.0 / 5.0</div>
            <div class="review-card__text">"{{ block.settings.quote }}"</div>
            <div class="review-card__author">{{ block.settings.author }}</div>
            {% if block.settings.verified %}
              <div class="review-card__verified">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M2 6.5L5 9.5L11 3.5" stroke="#76913e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Verified Buyer
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <!-- Mobile dots -->
      <div class="rev-dots" id="rev-dots-{{ section.id }}">
        {% for block in section.blocks %}
          <button class="rev-dot {% if forloop.first %}active{% endif %}" data-idx="{{ forloop.index0 }}" aria-label="Review {{ forloop.index }}"></button>
        {% endfor %}
      </div>

      <!-- CTA -->
      <div class="reviews__cta">
        {% if section.settings.cta_url != blank %}
          <a href="{{ section.settings.cta_url }}" class="btn-atc">{{ section.settings.cta_text }}</a>
        {% else %}
          <button class="btn-atc">{{ section.settings.cta_text }}</button>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<script>
(function() {
  var sid = '{{ section.id }}';
  var grid = document.getElementById('reviews-grid-' + sid);
  var dots = Array.from(document.querySelectorAll('#rev-dots-' + sid + ' .rev-dot'));

  if (grid && dots.length) {
    grid.addEventListener('scroll', function() {
      var cardWidth = 254 + 12;
      var idx = Math.round(grid.scrollLeft / cardWidth);
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === idx);
      });
    });

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        var cardWidth = 254 + 12;
        grid.scrollTo({ left: i * cardWidth, behavior: 'smooth' });
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "TS - Reviews",
  "tag": "section",
  "class": "ts-reviews",
  "settings": [
    { "type": "image_picker", "id": "strip_1", "label": "Strip Photo 1" },
    { "type": "image_picker", "id": "strip_2", "label": "Strip Photo 2" },
    { "type": "image_picker", "id": "strip_3", "label": "Strip Photo 3" },
    { "type": "text", "id": "rating_text", "label": "Rating Text", "default": "4.9 Stars · 2,400+ Happy Homes" },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "What 2,400+ Happy Homes Are Saying" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Add to Cart" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review Quote", "default": "Amazing candle!" },
        { "type": "text", "id": "author", "label": "Reviewer Name", "default": "Happy Customer" },
        {
          "type": "select",
          "id": "stars",
          "label": "Star Rating",
          "default": "5",
          "options": [
            { "value": "5", "label": "5 Stars" },
            { "value": "4", "label": "4 Stars" },
            { "value": "3", "label": "3 Stars" },
            { "value": "2", "label": "2 Stars" },
            { "value": "1", "label": "1 Star" }
          ]
        },
        { "type": "checkbox", "id": "verified", "label": "Verified Buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "TS - Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Texas Spring is the most beautiful candle I've ever burned. The scent is exactly what I imagined — fresh, floral, and so uniquely Texan.",
            "author": "Katherine L.",
            "stars": "5",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "I bought the starter kit and I'm obsessed. The wick trimmer makes such a difference. These candles are worth every penny.",
            "author": "Rachel W.",
            "stars": "5",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Bought three candles and they arrived the next day. The scent throw on these is unreal — my whole house smells incredible.",
            "author": "James P.",
            "stars": "5",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}