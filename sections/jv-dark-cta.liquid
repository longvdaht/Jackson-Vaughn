{% comment %} JV - Dark CTA {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Dosis:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    --cream: #FCFAEF;
    --cream-alt: #FAF7EF;
    --cream-warm: #FAE9C9;
    --dark: #232323;
    --text: #2D2B27;
    --btn-green: #36402D;
    --gold: #B78C47;
    --gold-bright: #F5B857;
    --gold-cta: #D6A24C;
    --gold-light: #EBDEc5;
    --green-check: #35911E;
    --white: #FFFFFF;
    --border: rgba(45,43,39,0.13);
    --font-heading: 'Petrona', serif;
    --font-body: 'Dosis', sans-serif;
  }

  #shopify-section-{{ section.id }} .dark-cta {
    background: #000;
    position: relative;
    overflow: hidden;
    padding: 64px 48px;
  }

  #shopify-section-{{ section.id }} .dark-cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .dark-cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .dark-cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.32) 60%, rgba(0,0,0,0.05) 100%);
  }

  #shopify-section-{{ section.id }} .dark-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .dcc {
    flex: 0 0 520px;
  }

  #shopify-section-{{ section.id }} .dcc .rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    margin-bottom: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .dcc .rating-row .stars {
    color: var(--gold-bright);
    font-size: 16px;
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .dcc h2 {
    font-family: 'Petrona', serif;
    font-size: 46px;
    font-weight: 500;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 16px;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .dcc p {
    font-family: var(--font-body);
    font-size: 17px;
    color: rgba(255,255,255,0.7);
    line-height: 1.65;
    margin-bottom: 28px;
    max-width: 440px;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .dc-badges {
    display: none;
    gap: 8px;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .dc-badge {
    background: rgba(255,255,255,0.12);
    padding: 14px 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .dc-badge-icon {
    width: 28px;
    height: 28px;
    background: var(--gold-bright);
    border-radius: 3px;
    opacity: 0.75;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .dc-badge-icon svg {
    width: 16px;
    height: 16px;
    fill: #fff;
  }

  #shopify-section-{{ section.id }} .dc-badge-text {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    line-height: 1.35;
    white-space: pre-line;
  }

  #shopify-section-{{ section.id }} .btn-cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gold-cta);
    color: #fff;
    border: none;
    width: 553px;
    max-width: 100%;
    height: 78px;
    font-family: 'Dosis', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .btn-cart:hover {
    opacity: 0.92;
  }

  #shopify-section-{{ section.id }} .dark-artisan {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.6);
    font-size: 13px;
    font-family: 'Dosis', sans-serif;
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .dark-artisan svg {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .dark-cta {
      padding: 40px 16px;
    }

    #shopify-section-{{ section.id }} .dark-cta-bg::after {
      background: rgba(0,0,0,0.55);
    }

    #shopify-section-{{ section.id }} .dark-cta-inner {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .dcc {
      flex: none;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .dcc h2 {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .dcc p {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .dc-badges {
      display: flex;
      flex-direction: row;
      gap: 8px;
      margin-bottom: 20px;
    }
  }
</style>

<section class="dark-cta">

  {%- comment %} Background Image {%- endcomment %}
  {%- if section.settings.bg_image != blank -%}
    <div class="dark-cta-bg">
      {{ section.settings.bg_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
    </div>
  {%- endif -%}

  <div class="dark-cta-inner">
    <div class="dcc">

      {%- comment %} Rating Row {%- endcomment %}
      <div class="rating-row">
        <span class="stars">★★★★★</span>
        <span>{{ section.settings.rating_text }}</span>
      </div>

      {%- comment %} Heading {%- endcomment %}
      <h2>{{ section.settings.heading }}</h2>

      {%- comment %} Body Copy {%- endcomment %}
      <p>{{ section.settings.body }}</p>

      {%- comment %} Mobile Badges — always in HTML, shown via CSS on mobile {%- endcomment %}
      <div class="dc-badges">
        <div class="dc-badge">
          <div class="dc-badge-icon">
            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 1L9.5 5.5H14.5L10.5 8.5L12 13L8 10L4 13L5.5 8.5L1.5 5.5H6.5L8 1Z"/>
            </svg>
          </div>
          <span class="dc-badge-text">{{ section.settings.badge_1_text }}</span>
        </div>
        <div class="dc-badge">
          <div class="dc-badge-icon">
            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 3h12v2H2zM2 7h12v2H2zM2 11h8v2H2z"/>
            </svg>
          </div>
          <span class="dc-badge-text">{{ section.settings.badge_2_text }}</span>
        </div>
        <div class="dc-badge">
          <div class="dc-badge-icon">
            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 1L10 6H15L11 9.5L12.5 14.5L8 11.5L3.5 14.5L5 9.5L1 6H6L8 1Z"/>
            </svg>
          </div>
          <span class="dc-badge-text">{{ section.settings.badge_3_text }}</span>
        </div>
      </div>

      {%- comment %} CTA Button {%- endcomment %}
      <a href="{{ section.settings.cta_url }}" class="btn-cart">{{ section.settings.cta_text }}</a>

      {%- comment %} Artisan Trust Line {%- endcomment %}
      <div class="dark-artisan">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 1.5L9.854 6.5H15.5L10.823 9.75L12.677 14.75L8 11.5L3.323 14.75L5.177 9.75L0.5 6.5H6.146L8 1.5Z" fill="rgba(255,255,255,0.4)"/>
        </svg>
        {{ section.settings.artisan_text }}
      </div>

    </div>
  </div>

</section>

{% schema %}
{
  "name": "JV - Dark CTA",
  "tag": "section",
  "class": "jv-section-dark-cta",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9 Stars · 2,400+ Happy Homes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bring Jackson Vaughn Into Your Home"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Copy",
      "default": "Hand-poured since 2000. Ready to burn the moment it arrives. Join 2,400+ houses that smell like a home."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "text",
      "id": "artisan_text",
      "label": "Artisan Trust Line",
      "default": "25 Years of Artisan Quality"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Rated 4.9\/5\nBy 2,400+"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "5 Texas Retail Locations"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Hand-Poured Since 2000"
    }
  ],
  "presets": [
    {
      "name": "JV - Dark CTA"
    }
  ]
}
{% endschema %}