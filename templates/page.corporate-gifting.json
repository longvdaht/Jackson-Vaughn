    "collapsible_content_7DBM8W": {
      "type": "collapsible-content",
      "blocks": {
        "content_K9W9Cg": {
          "type": "content",
          "settings": {
            "heading": "Do you offer volume discounts?",
            "content": "<p>Yes. We offer volume pricing for larger gifting orders. Share your estimated quantity and we’ll help find the best fit.</p>",
            "page": ""
          }
        },
        "content_LJPryq": {
          "type": "content",
          "settings": {
            "heading": "Can gifts be shipped to multiple recipients?",
            "content": "<p>Absolutely. We can help coordinate gifting to a single location or multiple recipients.</p>",
            "page": ""
          }
        },
        "content_Bpqw6c": {
          "type": "content",
          "settings": {
            "heading": "Do you offer custom packaging?",
            "content": "<p>For larger gifting orders, we offer custom packaging options to create a more personalized gifting experience.</p>",
            "page": ""
          }
        },
        "content_PTCmMy": {
          "type": "content",
          "settings": {
            "heading": "Can I include a gift message?",
            "content": "<p>Yes. We can help add personalized notes to make your gifts feel even more thoughtful.</p>",
            "page": ""
          }
        },
        "content_t37THN": {
          "type": "content",
          "settings": {
            "heading": "What occasions work well for corporate gifting?",
            "content": "<p>Our gifts are perfect for client appreciation, employee onboarding, closing gifts, holiday gifting, events, team milestones, and more.</p>",
            "page": ""
          }
        },
        "content_6wA8Wi": {
          "type": "content",
          "settings": {
            "heading": "Is there a minimum order quantity?",
            "content": "<p>Minimums may vary depending on customization and gifting needs. Reach out and we’ll help determine the best option for your order.</p>",
            "page": ""
          }
        },
        "content_YzXiVD": {
          "type": "content",
          "settings": {
            "heading": "How far in advance should I place my order?",
            "content": "<p>We recommend reaching out as early as possible, especially for larger or customized orders, to ensure timing and availability.</p>",
            "page": ""
          }
        },
        "content_66hbkc": {
          "type": "content",
          "settings": {
            "heading": "Can you help me choose gifts?",
            "content": "<p>Of course. Our team can help recommend products based on your occasion, budget, and gifting goals.</p>",
            "page": ""
          }
        },
        "content_hKpQmT": {
          "type": "content",
          "settings": {
            "heading": "Can I add my company branding?",
            "content": "<p>Depending on order size and customization needs, we may be able to create a more personalized gifting experience.</p>",
            "page": ""
          }
        },
        "content_xgB4t4": {
          "type": "content",
          "settings": {
            "heading": "Why candles for corporate gifts?",
            "content": "<p>Thoughtful gifts tend to leave a lasting impression. Our candles and home fragrance products become part of everyday rituals long after they're received.</p>",
            "page": ""
          }
        },
        "content_BxNAiP": {
          "type": "content",
