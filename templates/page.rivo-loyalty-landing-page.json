    "rivo_faq_i9rMNx": {
      "type": "rivo-faq",
      "blocks": {
        "faq_Qy87jP": {
          "type": "faq",
          "settings": {
            "question": "How do I join the loyalty program?",
            "answer": "<p>Simply sign up to create your account and start earning rewards!</p>"
          }
        },
        "faq_DdE6C3": {
          "type": "faq",
          "settings": {
            "question": "How can I earn points?",
            "answer": "<p>Earn points by signing up, making purchases, and more! Check out the “Ways to Earn” section for details.</p>"
          }
        },
        "faq_Da8dBn": {
          "type": "faq",
          "settings": {
            "question": "How do I redeem my points?",
            "answer": "<p>Log in, visit your dashboard, and visit the “Ways to Redeem” section to redeem your points for rewards.</p>"
          }
        },
        "faq_HgECbF": {
          "type": "faq",
          "settings": {
            "question": "Where can I see my points balance?",
            "answer": "<p>Log in to your account! Your points balance will be highlighted at the top of the page.</p>"
          }
        },
        "faq_Rg64Dc": {
          "type": "faq",
          "settings": {
            "question": "Do my points expire?",
            "answer": "<p>Points will expire after one year if there isn’t any account activity.</p>"
          }
        },
        "faq_hKKyrU": {
          "type": "faq",
          "settings": {
            "question": "Do my rewards expire?",
            "answer": "<p>Rewards will not expire once they are activated in the account.</p>"
          }
        },
        "faq_TKTfXx": {
          "type": "faq",
          "settings": {
            "question": "What happens to my points if I return a purchase?",
            "answer": "<p>If you return a purchase, the points you earned for that purchase will be deducted from your account.</p>"
          }
        },
        "faq_ryGnfH": {
          "type": "faq",
          "settings": {
            "question": "When do I get my birthday gift?",
            "answer": "<p>On your birthday! The only instance in which birthday points will be delayed until next year is if your birthday is within 30 days from the day you entered it.</p>"
          }
        },
        "faq_D4VKX7": {
          "type": "faq",
          "settings": {
            "question": "I forgot to use my points at Checkout, can I apply them retroactively?",
            "answer": "<p>No, unfortunately points cannot be redeemed on an order after the purchase has been completed.</p>"
          }
        },
        "referral_Xe4dUc": {
          "type": "referral",
          "settings": {
            "question": "How does the Refer a Friend program work?",
            "answer": "<p>When you refer a friend, they will receive a link to purchase with a special discount that will automatically apply to their first order, and you’ll receive a reward too!</p>"
          }
        },
        "referral_rbiDTU": {
          "type": "referral",
          "settings": {
            "question": "How do I refer a friend?",
            "answer": "<p>Enter your email address and share your unique referral link with friends and family. They can use the link to make their first purchase, and their discount will automatically be applied at checkout.</p>"
          }
        },
        "referral_fdBWnR": {
          "type": "referral",
          "settings": {
            "question": "How do I track the number of referrals I’ve made?",
            "answer": "<p>Enter your name and email above, then click My Stats. From there, you can send yourself an email which will contain your stats.</p>"
          }
        },
        "referral_YeV9BR": {
          "type": "referral",
          "settings": {
            "question": "Is there a limit to how many people I can refer?",
            "answer": "<p>No, there is no limit to the number of people you can refer. You can refer as many friends as you like, and you'll get a reward for each successful referral!</p>"
          }
        },
        "referral_QBXV7p": {
          "type": "referral",
          "settings": {
